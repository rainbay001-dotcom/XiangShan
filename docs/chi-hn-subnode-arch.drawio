        <!-- ============================================================ -->
        <!-- CHIHNSubNode Internal Detail Box -->
        <!-- ============================================================ -->
        <mxCell id="detail_box" value="CHIHNSubNode 内部结构 (HNSubNode.scala)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0d4;strokeColor=#d6820a;fontSize=12;fontStyle=1;verticalAlign=top;arcSize=2;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1840" y="260" width="900" height="1280" as="geometry" />
        </mxCell>

        <!-- Detail: Title -->
        <mxCell id="detail_title" value="CHIHNSubNode 详细说明" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1860" y="290" width="860" height="30" as="geometry" />
        </mxCell>

        <!-- Detail: Module signature -->
        <mxCell id="detail_sig" value="class CHIHNSubNode(val numCores: Int)(implicit p: Parameters) extends Module" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1860" y="330" width="860" height="30" as="geometry" />
        </mxCell>

        <!-- Detail: IO Bundle box -->
        <mxCell id="detail_io" value="IO Bundle&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;rnFromL2    : Vec(numCores, Flipped(PortIO))  ← HN 侧，L2 作为 RN 接入&#xa;rnToOpenLLC : Vec(numCores, PortIO)           → RN 侧，连入 OpenLLC.io.rn[]&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;// 透明传递（当前实现）&#xa;for (i &lt;- 0 until numCores) {&#xa;  io.rnToOpenLLC(i) &lt;&gt; io.rnFromL2(i)&#xa;}" style="rounded=0;whiteSpace=pre;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1860" y="375" width="860" height="180" as="geometry" />
        </mxCell>

        <!-- Detail: PortIO structure -->
        <mxCell id="detail_portio" value="PortIO (CHI E.b 协议通道)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1860" y="570" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="detail_portio_box" value="TX 方向（节点 → 对端）&#xa;  tx.req.*   请求通道 (REQ)&#xa;  tx.rsp.*   响应通道 (RSP)&#xa;  tx.dat.*   数据通道 (DAT)&#xa;  tx.linkactiveack&#xa;  syscoreq / syscoack&#xa;RX 方向（对端 → 节点）&#xa;  rx.snp.*   监听通道 (SNP)&#xa;  rx.rsp.*   响应通道 (RSP)&#xa;  rx.dat.*   数据通道 (DAT)&#xa;  rx.linkactivereq&#xa;  rxsactive" style="rounded=0;whiteSpace=pre;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1860" y="600" width="380" height="280" as="geometry" />
        </mxCell>

        <!-- Detail: CHI Node Roles -->
        <mxCell id="detail_roles" value="CHI 节点角色定义" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="2280" y="570" width="420" height="24" as="geometry" />
        </mxCell>
        <mxCell id="detail_roles_box" value="RN (Request Node / 请求节点)&#xa;  发起内存请求，含 L2 缓存&#xa;  本节点以 RN 身份连入 OpenLLC&#xa;&#xa;HN (Home Node / 归属节点)&#xa;  响应 RN 请求，维护一致性目录&#xa;  本节点以 HN 身份面向 L2&#xa;  OpenLLC 是真正的全局 HN-F&#xa;&#xa;SN (Subordinate Node / 从属节点)&#xa;  提供数据存储&#xa;  NCB Bridge 充当 SN → DRAM" style="rounded=0;whiteSpace=pre;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2280" y="600" width="430" height="280" as="geometry" />
        </mxCell>

        <!-- Detail: Top.scala connection code -->
        <mxCell id="detail_top_title" value="Top.scala 关键修改 (CHI 路径)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1860" y="895" width="860" height="24" as="geometry" />
        </mxCell>
        <mxCell id="detail_top_code" value="// 创建 HN 子节点实例&#xa;val chiHNSubNode = Module(new CHIHNSubNode(core_with_l2.length))&#xa;&#xa;for ((core, i) &lt;- core_with_l2.zipWithIndex) {&#xa;  val mmioLogger = CHILogger(s&quot;L2[${i}]_MMIO&quot;, true)&#xa;  val hnLogger   = CHILogger(s&quot;L2[${i}]_HN&quot;, true)   // L2 → HNSubNode&#xa;  val llcLogger  = CHILogger(s&quot;HN[${i}]_LLC&quot;, true)  // HNSubNode → OpenLLC&#xa;&#xa;  // L2 流量通过 route/bind 分流：MMIO → NCB, MEM → HNSubNode&#xa;  bind(route(core.module.io.chi.get, addrMap),&#xa;       Map(mmioID -&gt; mmioLogger.io.up, hnID -&gt; hnLogger.io.up))&#xa;&#xa;  chi_mmioBridge_opt(i).get.module.io.chi.connect(mmioLogger.io.down)&#xa;&#xa;  // L2 (RN) → HNSubNode: 子节点以 HN 身份接收 L2 请求&#xa;  chiHNSubNode.io.rnFromL2(i) &lt;&gt; hnLogger.io.down&#xa;&#xa;  // HNSubNode (RN) → OpenLLC: 子节点以 RN 身份接入 OpenLLC&#xa;  llcLogger.io.up &lt;&gt; chiHNSubNode.io.rnToOpenLLC(i)&#xa;  chi_openllc_opt.get.io.rn(i) &lt;&gt; llcLogger.io.down&#xa;}" style="rounded=0;whiteSpace=pre;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1860" y="925" width="860" height="380" as="geometry" />
        </mxCell>

        <!-- Detail: Extensibility note -->
        <mxCell id="detail_ext" value="扩展路线图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1860" y="1320" width="860" height="24" as="geometry" />
        </mxCell>
        <mxCell id="detail_ext_box" value="当前：透明传递（骨架）&#xa;&#xa;阶段 1：集群级目录 (Cluster-level Directory)&#xa;  在 CHIHNSubNode 内维护 L2 地址对应关系，过滤跨 L2 Snoop&#xa;&#xa;阶段 2：Snoop 过滤&#xa;  拦截来自 OpenLLC 的 SNP，仅向持有副本的 L2 发送&#xa;  减少无效 Snoop 广播&#xa;&#xa;阶段 3：请求合并&#xa;  合并多个 L2 对同一 cacheline 的请求后再转发 OpenLLC&#xa;&#xa;阶段 4：集群级数据缓存&#xa;  在 CHIHNSubNode 内加入 Cluster Cache，进一步减少 LLC 访问" style="rounded=0;whiteSpace=pre;html=1;fillColor=#fff0d4;strokeColor=#d6820a;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1860" y="1350" width="860" height="170" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- Arrow showing key change -->
        <!-- ============================================================ -->
        <mxCell id="change_arrow" value="新增 CHIHNSubNode 层" style="endArrow=block;endFill=1;strokeColor=#d6820a;strokeWidth=4;fillColor=#fff0d4;fontStyle=1;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1820" y="430" as="sourcePoint" />
            <mxPoint x="1820" y="1090" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
