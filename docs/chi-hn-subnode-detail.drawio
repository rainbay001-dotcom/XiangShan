    <!-- Left: rnFromL2 ports (HN side) -->
    <mxCell id="rn_from_label" value="&lt;b&gt;io.rnFromL2&lt;/b&gt;&#xa;对 L2 呈现为 HN-F&#xa;Vec(numCores, Flipped(new PortIO))" style="text;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="400" width="205" height="60" as="geometry" />
    </mxCell>
    <mxCell id="port_from0" value="&lt;b&gt;rnFromL2[0]&lt;/b&gt; — Core 0 L2&#xa;──────────────────&#xa;[TX → HN（L2 发出）]&#xa;  tx.req: flitpend/flitv/flit(256b)/lcrdv&#xa;  tx.rsp: flitpend/flitv/flit(128b)/lcrdv&#xa;  tx.dat: flitpend/flitv/flit(512b)/lcrdv&#xa;  tx.linkactiveack: Bool&#xa;[RX ← HN（L2 接收）]&#xa;  rx.snp: flitpend/flitv/flit(256b)/lcrdv&#xa;  rx.rsp: flitpend/flitv/flit(128b)/lcrdv&#xa;  rx.dat: flitpend/flitv/flit(512b)/lcrdv&#xa;  rx.linkactivereq: Bool&#xa;链路控制:&#xa;  rxsactive/syscoreq/syscoack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="20" y="470" width="225" height="280" as="geometry" />
    </mxCell>
    <mxCell id="port_from1" value="&lt;b&gt;rnFromL2[1]&lt;/b&gt; — Core 1 L2&#xa;──────────────────&#xa;[TX → HN（L2 发出）]&#xa;  tx.req: flitpend/flitv/flit(256b)/lcrdv&#xa;  tx.rsp: flitpend/flitv/flit(128b)/lcrdv&#xa;  tx.dat: flitpend/flitv/flit(512b)/lcrdv&#xa;  tx.linkactiveack: Bool&#xa;[RX ← HN（L2 接收）]&#xa;  rx.snp: flitpend/flitv/flit(256b)/lcrdv&#xa;  rx.rsp: flitpend/flitv/flit(128b)/lcrdv&#xa;  rx.dat: flitpend/flitv/flit(512b)/lcrdv&#xa;  rx.linkactivereq: Bool&#xa;链路控制:&#xa;  rxsactive/syscoreq/syscoack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="20" y="770" width="225" height="280" as="geometry" />
    </mxCell>

    <!-- Center: CHIHNSubNode module frame -->
    <mxCell id="main_frame" value="&lt;b&gt;CHIHNSubNode&lt;/b&gt;（class CHIHNSubNode(val numCores: Int)）" style="swimlane;startSize=36;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="275" y="395" width="880" height="680" as="geometry" />
    </mxCell>

    <!-- Core passthrough logic inside main_frame -->
    <mxCell id="pass_bg" value="核心逻辑（当前实现：透明传递）" style="swimlane;startSize=26;fillColor=#f5f5f5;strokeColor=#666;fontStyle=1;fontSize=11;" vertex="1" parent="main_frame">
      <mxGeometry x="10" y="46" width="860" height="115" as="geometry" />
    </mxCell>
    <mxCell id="pass_loop" value="for (i &lt;- 0 until numCores) {&#xa;  io.rnToOpenLLC(i) &lt;&gt; io.rnFromL2(i)&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontFamily=Courier New;fontSize=11;align=left;" vertex="1" parent="pass_bg">
      <mxGeometry x="10" y="32" width="340" height="68" as="geometry" />
    </mxCell>
    <mxCell id="pass_note" value="透明传递：rnFromL2[i] 的所有信号直接&#xa;双向绑定到 rnToOpenLLC[i]&#xa;（&lt;&gt; 完成双方向信号连接）" style="text;html=1;fillColor=#ffffc0;strokeColor=#e6e600;fontSize=10;align=left;" vertex="1" parent="pass_bg">
      <mxGeometry x="370" y="32" width="480" height="68" as="geometry" />
    </mxCell>

    <!-- Extension points inside main_frame -->
    <mxCell id="ext_bg" value="扩展点（Future Extensions）" style="swimlane;startSize=26;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="main_frame">
      <mxGeometry x="10" y="178" width="860" height="490" as="geometry" />
    </mxCell>

    <!-- EXT-1: Cluster Directory -->
    <mxCell id="ext1" value="&lt;b&gt;[EXT-1] 集群级目录&lt;/b&gt;&#xa;Cluster-level Directory&#xa;─────────────────&#xa;• 维护集群内 L2 共享状态&#xa;• 目录命中时无需上报 OpenLLC&#xa;• 减少对 OpenLLC 的频繁访问&#xa;• 适合 NUMA 多核场景&#xa;• 减少跨集群总线流量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_bg">
      <mxGeometry x="10" y="40" width="195" height="175" as="geometry" />
    </mxCell>

    <!-- EXT-2: Snoop Filter -->
    <mxCell id="ext2" value="&lt;b&gt;[EXT-2] Snoop 过滤器&lt;/b&gt;&#xa;Cross-L2 Snoop Filter&#xa;─────────────────&#xa;• 追踪每个 L2 持有的 cacheline&#xa;• 避免广播不必要的 Snoop&#xa;• 减少 L2 被打扰次数&#xa;• 改善尾延迟（tail latency）&#xa;• 使用 Bloom Filter 或精确目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_bg">
      <mxGeometry x="220" y="40" width="195" height="175" as="geometry" />
    </mxCell>

    <!-- EXT-3: Request Merge -->
    <mxCell id="ext3" value="&lt;b&gt;[EXT-3] 请求合并&lt;/b&gt;&#xa;Request Coalescing&#xa;─────────────────&#xa;• 多个 L2 同时 Miss 同一地址时&#xa;  合并为一条向 OpenLLC 的请求&#xa;• 减少 OpenLLC MSHR 压力&#xa;• 提升大规模并发访存效率&#xa;• 与 Snoop Filter 协同工作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_bg">
      <mxGeometry x="430" y="40" width="195" height="175" as="geometry" />
    </mxCell>

    <!-- EXT-4: Cluster Cache -->
    <mxCell id="ext4" value="&lt;b&gt;[EXT-4] 集群缓存（L2.5 / L3 前级）&lt;/b&gt;&#xa;Cluster-level Cache&#xa;────────────────────────────────────────────&#xa;• 在 HNSubNode 内嵌入小型 SRAM（128KB~1MB）&#xa;• 缓存集群热点 cacheline，降低访问 OpenLLC 频率&#xa;• 相当于集群级 L2.5，减少跨集群流量&#xa;• 需配合 EXT-1 集群目录管理 State&#xa;• 多集群系统中可显著提升能效比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_bg">
      <mxGeometry x="10" y="240" width="840" height="115" as="geometry" />
    </mxCell>

    <!-- Extension connections (conceptual arrows inside ext_bg) -->
