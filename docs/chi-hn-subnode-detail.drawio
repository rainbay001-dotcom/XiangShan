    <!-- ======== Internal: Passthrough core ======== -->
    <mxCell id="pass_frame" value="核心逻辑（当前实现）" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="80" y="70" width="700" height="200" as="geometry" />
    </mxCell>

    <mxCell id="pass_loop" value="for (i &lt;- 0 until numCores) {&#xa;  io.rnToOpenLLC(i) &lt;&gt; io.rnFromL2(i)&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontFamily=Courier New;fontSize=11;align=left;" vertex="1" parent="main_frame">
      <mxGeometry x="80" y="70" width="340" height="80" as="geometry" />
    </mxCell>

    <mxCell id="pass_note" value="透明传递：每个 rnFromL2[i] 的所有信号&#xa;直接双向绑定到 rnToOpenLLC[i]&#xa;（&lt;&gt; 操作符完成双方向信号连接）" style="text;html=1;strokeColor=none;fillColor=#ffffc0;fontSize=10;align=left;" vertex="1" parent="main_frame">
      <mxGeometry x="450" y="70" width="350" height="80" as="geometry" />
    </mxCell>

    <!-- ======== Internal: Extension points ======== -->
    <mxCell id="ext_frame" value="扩展点（Future Extensions）" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="main_frame">
      <mxGeometry x="80" y="190" width="700" height="450" as="geometry" />
    </mxCell>

    <!-- Ext 1: Cluster Directory -->
    <mxCell id="ext1" value="&lt;b&gt;[EXT-1] 集群级目录&lt;/b&gt;&#xa;Cluster-level Directory&#xa;────────────────────&#xa;• 维护集群内 L2 共享状态&#xa;• 目录命中时无需上报 OpenLLC&#xa;• 减少对 OpenLLC 的频繁访问&#xa;• 适合 NUMA 多核场景" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_frame">
      <mxGeometry x="20" y="40" width="200" height="140" as="geometry" />
    </mxCell>

    <!-- Ext 2: Snoop Filter -->
    <mxCell id="ext2" value="&lt;b&gt;[EXT-2] Snoop 过滤器&lt;/b&gt;&#xa;Cross-L2 Snoop Filter&#xa;────────────────────&#xa;• 追踪每个 L2 持有的 cacheline&#xa;• 避免广播不必要的 Snoop&#xa;• 减少 L2 被打扰次数&#xa;• 改善尾延迟（tail latency）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_frame">
      <mxGeometry x="240" y="40" width="200" height="140" as="geometry" />
    </mxCell>

    <!-- Ext 3: Request Merge -->
    <mxCell id="ext3" value="&lt;b&gt;[EXT-3] 请求合并&lt;/b&gt;&#xa;Request Coalescing&#xa;────────────────────&#xa;• 多个 L2 同时 Miss 同一地址时&#xa;  合并为一条向 OpenLLC 的请求&#xa;• 减少 OpenLLC MSHR 压力&#xa;• 提升大规模并发访存效率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_frame">
      <mxGeometry x="460" y="40" width="200" height="140" as="geometry" />
    </mxCell>

    <!-- Ext 4: Cluster Cache -->
    <mxCell id="ext4" value="&lt;b&gt;[EXT-4] 集群缓存&lt;/b&gt;&#xa;Cluster-level Cache&#xa;────────────────────&#xa;• 在 HNSubNode 内嵌入小型 SRAM&#xa;• 缓存热点 cacheline，降低访问&#xa;  OpenLLC 频率&#xa;• 相当于集群级 L2.5 / L3&#xa;  减少跨集群流量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="ext_frame">
      <mxGeometry x="20" y="230" width="640" height="140" as="geometry" />
    </mxCell>

