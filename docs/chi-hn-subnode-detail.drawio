      <mxGeometry x="1190" y="470" width="240" height="280" as="geometry" />
    </mxCell>
    <mxCell id="port_to1" value="&lt;b&gt;rnToOpenLLC[1]&lt;/b&gt; — → OpenLLC.rn[1]&#xa;──────────────────&#xa;[TX → OpenLLC（作为 RN 发出）]&#xa;  tx.req: flitpend/flitv/flit(256b)/lcrdv&#xa;  tx.rsp: flitpend/flitv/flit(128b)/lcrdv&#xa;  tx.dat: flitpend/flitv/flit(512b)/lcrdv&#xa;  tx.linkactiveack: Bool&#xa;[RX ← OpenLLC（从 OpenLLC 接收）]&#xa;  rx.snp: flitpend/flitv/flit(256b)/lcrdv&#xa;  rx.rsp: flitpend/flitv/flit(128b)/lcrdv&#xa;  rx.dat: flitpend/flitv/flit(512b)/lcrdv&#xa;  rx.linkactivereq: Bool&#xa;链路控制:&#xa;  rxsactive/syscoreq/syscoack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="1190" y="770" width="240" height="280" as="geometry" />
    </mxCell>

