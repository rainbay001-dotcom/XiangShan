    <!-- ===================== §4 节点角色 + 代码骨架 (y=1365) ===================== -->
    <mxCell id="role_box" value="&lt;b&gt;CHI 节点角色说明&lt;/b&gt;&#xa;────────────────────────────────────────────&#xa;RN（Request Node）：发起 Cache/Memory 访问请求的节点（L2 缓存、CHIHNSubNode 对 OpenLLC 时）&#xa;HN（Home Node）：维护地址一致性、接收 RN 请求并协调 Snoop（OpenLLC、CHIHNSubNode 对 L2 时）&#xa;SN（Slave Node）：最终数据存储节点（DRAM 控制器，通过 OpenNCB 桥接 AXI）&#xa;────────────────────────────────────────────&#xa;&lt;b&gt;CHIHNSubNode 双重角色：&lt;/b&gt;&#xa;• 对 CoreWithL2（L2）：充当 HN-F，接收 L2 的 CHI 请求&#xa;• 对 OpenLLC：充当 RN，以请求者身份将请求转发给全局 HN-F（OpenLLC）" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="1365" width="960" height="155" as="geometry" />
    </mxCell>

    <mxCell id="code_box" value="&lt;b&gt;Chisel 代码骨架&lt;/b&gt;（src/main/scala/top/HNSubNode.scala）&#xa;────────────────────────────────────────────────────────&#xa;class CHIHNSubNode(val numCores: Int)(implicit p: Parameters) extends Module {&#xa;  val io = IO(new Bundle {&#xa;    val rnFromL2    = Vec(numCores, Flipped(new PortIO))  // HN 侧&#xa;    val rnToOpenLLC = Vec(numCores, new PortIO)           // RN 侧&#xa;  })&#xa;  // 当前：透明传递&#xa;  for (i &lt;- 0 until numCores) {&#xa;    io.rnToOpenLLC(i) &lt;&gt; io.rnFromL2(i)&#xa;  }&#xa;  // [EXT-1] 集群目录逻辑在此扩展&#xa;  // [EXT-2] Snoop 过滤逻辑在此扩展&#xa;  // [EXT-3] 请求合并逻辑在此扩展&#xa;  // [EXT-4] 集群缓存 SRAM 在此扩展&#xa;}" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;align=left;fontSize=10;fontFamily=Courier New;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="1000" y="1365" width="640" height="225" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
