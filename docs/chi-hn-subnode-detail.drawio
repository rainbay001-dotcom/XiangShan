    <!-- ===================== §2 CHIHNSubNode 详细 IO 与内部结构 (y=375) ===================== -->
    <mxCell id="sec2_title" value="§2  CHIHNSubNode 详细 IO 接口与内部结构" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
