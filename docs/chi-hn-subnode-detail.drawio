    <!-- ===================== Section D: 节点角色说明 ===================== -->
    <mxCell id="role_box" value="&lt;b&gt;CHI 节点角色说明&lt;/b&gt;&#xa;────────────────────────────────────────&#xa;RN（Request Node）：发起 Cache/Memory 访问请求的节点（例如 L2 缓存、CHIHNSubNode 向 OpenLLC 发起请求时）&#xa;HN（Home Node）：负责维护地址一致性的节点，接收 RN 请求并协调 Snoop（例如 OpenLLC、CHIHNSubNode 面向 L2 时）&#xa;SN（Slave Node）：最终的数据存储节点（例如 DRAM 控制器，通过 OpenNCB 桥接到 AXI）&#xa;────────────────────────────────────────&#xa;&lt;b&gt;CHIHNSubNode 的双重角色：&lt;/b&gt;&#xa;• 对 CoreWithL2（L2）：充当 HN-F，接收 L2 的 CHI 请求&#xa;• 对 OpenLLC：充当 RN，以请求者身份将请求转发给全局 HN-F（OpenLLC）" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="100" y="1390" width="1000" height="145" as="geometry" />
    </mxCell>

    <!-- ===================== Section E: 代码骨架 ===================== -->
    <mxCell id="code_box" value="&lt;b&gt;Chisel 代码骨架（src/main/scala/top/HNSubNode.scala）&lt;/b&gt;&#xa;────────────────────────────────────────────────────────&#xa;class CHIHNSubNode(val numCores: Int)(implicit p: Parameters) extends Module {&#xa;  val io = IO(new Bundle {&#xa;    val rnFromL2    = Vec(numCores, Flipped(new PortIO))   // HN 侧：接收 L2 请求&#xa;    val rnToOpenLLC = Vec(numCores, new PortIO)            // RN 侧：转发给 OpenLLC&#xa;  })&#xa;&#xa;  // 当前：透明传递（直连）&#xa;  for (i &lt;- 0 until numCores) {&#xa;    io.rnToOpenLLC(i) &lt;&gt; io.rnFromL2(i)&#xa;  }&#xa;  // [EXT-1] 在此添加集群目录逻辑&#xa;  // [EXT-2] 在此添加 Snoop 过滤逻辑&#xa;  // [EXT-3] 在此添加请求合并逻辑&#xa;  // [EXT-4] 在此添加集群缓存 SRAM&#xa;}" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;align=left;fontSize=10;fontFamily=Courier New;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="1120" y="1390" width="600" height="220" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
