      <mxGeometry x="1000" y="1380" width="640" height="230" as="geometry" />
    </mxCell>

    <!-- ===================== Description Table ===================== -->
    <mxCell id="desc_table_title" value="说明表 / Description Table" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="1690" width="400" height="40" as="geometry" />
    </mxCell>
    <mxCell id="desc_table_content" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;th&gt;模块 / Module&lt;/th&gt;&lt;th&gt;说明 / Description&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;CoreWithL2[0]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;（RN-F）&lt;br/&gt;io.chi.get&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;CoreWithL2[1]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;（RN-F）&lt;br/&gt;io.chi.get&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;CHIHNSubNode&lt;/b&gt;&lt;/td&gt;&lt;td&gt;rnFromL2[0..1]&lt;br/&gt;rnToOpenLLC[0..1]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;OpenLLC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;（HN-F）&lt;br/&gt;io.rn[0..1]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;io.rnFromL2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;对 L2 呈现为 HN-F&lt;br/&gt;Vec(numCores, Flipped(new PortIO))&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;rnFromL2[0]&lt;/b&gt; — Core 0 L2&lt;/td&gt;&lt;td&gt;──────────────────&lt;br/&gt;[TX → HN（L2 发出）]&lt;br/&gt;  tx.req: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  tx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  tx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  tx.linkactiveack: Bool&lt;br/&gt;[RX ← HN（L2 接收）]&lt;br/&gt;  rx.snp: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  rx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  rx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  rx.linkactivereq: Bool&lt;br/&gt;链路控制:&lt;br/&gt;  rxsactive/syscoreq/syscoack&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;rnFromL2[1]&lt;/b&gt; — Core 1 L2&lt;/td&gt;&lt;td&gt;──────────────────&lt;br/&gt;[TX → HN（L2 发出）]&lt;br/&gt;  tx.req: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  tx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  tx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  tx.linkactiveack: Bool&lt;br/&gt;[RX ← HN（L2 接收）]&lt;br/&gt;  rx.snp: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  rx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  rx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  rx.linkactivereq: Bool&lt;br/&gt;链路控制:&lt;br/&gt;  rxsactive/syscoreq/syscoack&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;io.rnToOpenLLC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;对 OpenLLC 呈现为 RN&lt;br/&gt;Vec(numCores, new PortIO)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;rnToOpenLLC[0]&lt;/b&gt; — → OpenLLC.rn[0]&lt;/td&gt;&lt;td&gt;──────────────────&lt;br/&gt;[TX → OpenLLC（作为 RN 发出）]&lt;br/&gt;  tx.req: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  tx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  tx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  tx.linkactiveack: Bool&lt;br/&gt;[RX ← OpenLLC（从 OpenLLC 接收）]&lt;br/&gt;  rx.snp: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  rx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  rx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  rx.linkactivereq: Bool&lt;br/&gt;链路控制:&lt;br/&gt;  rxsactive/syscoreq/syscoack&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;rnToOpenLLC[1]&lt;/b&gt; — → OpenLLC.rn[1]&lt;/td&gt;&lt;td&gt;──────────────────&lt;br/&gt;[TX → OpenLLC（作为 RN 发出）]&lt;br/&gt;  tx.req: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  tx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  tx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  tx.linkactiveack: Bool&lt;br/&gt;[RX ← OpenLLC（从 OpenLLC 接收）]&lt;br/&gt;  rx.snp: flitpend/flitv/flit(256b)/lcrdv&lt;br/&gt;  rx.rsp: flitpend/flitv/flit(128b)/lcrdv&lt;br/&gt;  rx.dat: flitpend/flitv/flit(512b)/lcrdv&lt;br/&gt;  rx.linkactivereq: Bool&lt;br/&gt;链路控制:&lt;br/&gt;  rxsactive/syscoreq/syscoack&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[EXT-1] 集群级目录&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cluster-level Directory&lt;br/&gt;─────────────────&lt;br/&gt;• 维护集群内 L2 共享状态&lt;br/&gt;• 目录命中时无需上报 OpenLLC&lt;br/&gt;• 减少对 OpenLLC 的频繁访问&lt;br/&gt;• 适合 NUMA 多核场景&lt;br/&gt;• 减少跨集群总线流量&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[EXT-2] Snoop 过滤器&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cross-L2 Snoop Filter&lt;br/&gt;─────────────────&lt;br/&gt;• 追踪每个 L2 持有的 cacheline&lt;br/&gt;• 避免广播不必要的 Snoop&lt;br/&gt;• 减少 L2 被打扰次数&lt;br/&gt;• 改善尾延迟（tail latency）&lt;br/&gt;• 使用 Bloom Filter 或精确目录&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[EXT-3] 请求合并&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Request Coalescing&lt;br/&gt;─────────────────&lt;br/&gt;• 多个 L2 同时 Miss 同一地址时&lt;br/&gt;  合并为一条向 OpenLLC 的请求&lt;br/&gt;• 减少 OpenLLC MSHR 压力&lt;br/&gt;• 提升大规模并发访存效率&lt;br/&gt;• 与 Snoop Filter 协同工作&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[EXT-4] 集群缓存（L2.5 / L3 前级）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cluster-level Cache&lt;br/&gt;────────────────────────────────────────────&lt;br/&gt;• 在 HNSubNode 内嵌入小型 SRAM（128KB~1MB）&lt;br/&gt;• 缓存集群热点 cacheline，降低访问 OpenLLC 频率&lt;br/&gt;• 相当于集群级 L2.5，减少跨集群流量&lt;br/&gt;• 需配合 EXT-1 集群目录管理 State&lt;br/&gt;• 多集群系统中可显著提升能效比&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;CHI 节点角色说明&lt;/b&gt;&lt;/td&gt;&lt;td&gt;────────────────────────────────────────────&lt;br/&gt;RN（Request Node）：发起 Cache/Memory 访问请求的节点（L2 缓存、CHIHNSubNode 对 OpenLLC 时）&lt;br/&gt;HN（Home Node）：维护地址一致性、接收 RN 请求并协调 Snoop（OpenLLC、CHIHNSubNode 对 L2 时）&lt;br/&gt;SN（Slave Node）：最终数据存储节点（DRAM 控制器，通过 OpenNCB 桥接 AXI）&lt;br/&gt;────────────────────────────────────────────&lt;br/&gt;&lt;b&gt;CHIHNSubNode 双重角色：&lt;/b&gt;&lt;br/&gt;• 对 CoreWithL2（L2）：充当 HN-F，接收 L2 的 CHI 请求&lt;br/&gt;• 对 OpenLLC：充当 RN，以请求者身份将请求转发给全局 HN-F（OpenLLC）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Chisel 代码骨架&lt;/b&gt;（src/main/scala/top/HNSubNode.scala）&lt;/td&gt;&lt;td&gt;────────────────────────────────────────────────────────&lt;br/&gt;class CHIHNSubNode(val numCores: Int)(implicit p: Parameters) extends Module {&lt;br/&gt;  val io = IO(new Bundle {&lt;br/&gt;    val rnFromL2    = Vec(numCores, Flipped(new PortIO))  // HN 侧&lt;br/&gt;    val rnToOpenLLC = Vec(numCores, new PortIO)           // RN 侧&lt;br/&gt;  })&lt;br/&gt;  // 当前：透明传递&lt;br/&gt;  for (i &amp;lt;- 0 until numCores) {&lt;br/&gt;    io.rnToOpenLLC(i) &amp;lt;&amp;gt; io.rnFromL2(i)&lt;br/&gt;  }&lt;br/&gt;  // [EXT-1] 集群目录逻辑在此扩展&lt;br/&gt;  // [EXT-2] Snoop 过滤逻辑在此扩展&lt;br/&gt;  // [EXT-3] 请求合并逻辑在此扩展&lt;br/&gt;  // [EXT-4] 集群缓存 SRAM 在此扩展&lt;br/&gt;}&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="20" y="1740" width="1860" height="1020" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
