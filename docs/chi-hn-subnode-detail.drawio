    <!-- ===================== §4 节点角色 + 代码骨架 (y=1365) ===================== -->
    <mxCell id="role_box" value="&lt;b&gt;CHI 节点角色说明&lt;/b&gt;" style="text;html=1;strokeColor=#555555;align=left;fontSize=10;whiteSpace=wrap;fillColor=none;" vertex="1" parent="1">
