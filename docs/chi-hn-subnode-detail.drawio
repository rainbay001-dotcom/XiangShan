      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="ee14" value="辅助" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;dashed=1;endArrow=open;fontSize=9;" edge="1" source="ext1" target="ext4" parent="ext_bg">
