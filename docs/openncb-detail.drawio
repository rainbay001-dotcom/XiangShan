    <!-- read_path → tx_arb (CompData) -->
    <mxCell id="fe7" value="CompData" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="read_path" target="tx_arb" parent="1">
