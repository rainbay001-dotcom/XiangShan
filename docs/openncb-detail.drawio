    <mxCell id="ih1" value="LLC Bridge（内存主存）" style="text;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1042" width="290" height="28" as="geometry"/></mxCell>
    <mxCell id="ih2" value="MMIO Bridge × N（外设）" style="text;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="1042" width="340" height="28" as="geometry"/></mxCell>

