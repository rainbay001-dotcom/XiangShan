    <mxCell id="ir1b" value="64" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1070" width="290" height="26" as="geometry"/></mxCell>
    <mxCell id="ir1c" value="32" style="text;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="1070" width="340" height="26" as="geometry"/></mxCell>

