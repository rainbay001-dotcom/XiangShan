    <!-- write_path → axi_arb (AW/W) -->
    <mxCell id="fe11" value="AW/W 发出" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" source="write_path" target="axi_arb" parent="1">
      <mxGeometry relative="1" as="geometry">
