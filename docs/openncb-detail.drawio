<mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ===================== Title ===================== -->
    <mxCell id="t1" value="OpenNCB（非一致性 CHI→AXI4 桥）详细架构图 — XiangShan KunminghuV2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="15" width="1660" height="40" as="geometry" />
    </mxCell>

    <!-- ===================== Overview ===================== -->
    <mxCell id="overview" value="&lt;b&gt;OpenNCB 角色：&lt;/b&gt; CHI 协议的 SN（Slave Node），接收来自 OpenLLC（HN-F）发出的 ReadNoSnp / WriteNoSnpFull 等请求，将其翻译为 AXI4 读/写事务发往 DRAM（或 MMIO）。&#xa;XiangShan 中部署两类实例：① LLC Bridge（outstandingDepth=64，接 DDR/HBM 主存）  ② MMIO Bridge × NumCores（outstandingDepth=32，接外设总线）" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="65" width="1660" height="65" as="geometry" />
    </mxCell>

    <!-- ===================== CHI SN Port (Left, y=150) ===================== -->
    <mxCell id="chi_label" value="CHI SN 接口&#xa;（来自 OpenLLC io.sn）" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;align=center;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="150" width="155" height="40" as="geometry" />
    </mxCell>
    <mxCell id="chi_port" value="&lt;b&gt;CHI PortIO（SN 侧）&lt;/b&gt;&#xa;OpenNCB 以 &lt;b&gt;SN&lt;/b&gt; 身份接入 CHI&#xa;&#xa;RX（接收来自 HN 的请求）:&#xa;  REQ: flitv / flit(256b) / lcrdv&#xa;  DAT: flitv / flit(512b) / lcrdv&#xa;    （NonCopyBackWrData）&#xa;&#xa;TX（发送响应给 HN）:&#xa;  RSP: flitv / flit(128b) / lcrdv&#xa;    （DBIDResp / Comp / CompDBIDResp）&#xa;  DAT: flitv / flit(512b) / lcrdv&#xa;    （CompData 读数据返回）&#xa;&#xa;链路控制: linkactive{req,ack} / rxsactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="20" y="200" width="195" height="255" as="geometry" />
    </mxCell>

    <!-- ===================== AXI4 Master Port (Right, y=150) ===================== -->
    <mxCell id="axi_label" value="AXI4 主接口&#xa;（→ DRAM / MMIO）" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;align=center;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1525" y="150" width="155" height="40" as="geometry" />
    </mxCell>
    <mxCell id="axi_port" value="&lt;b&gt;AXI4 Master Interface&lt;/b&gt;&#xa;OpenNCB 作为 AXI4 Master&#xa;&#xa;写通道（W）:&#xa;  AW: addr / id / len / burst / cache&#xa;  W : data(256/512b) / strb / last&#xa;  B : bid / bresp（写响应）&#xa;&#xa;读通道（R）:&#xa;  AR: addr / id / len / burst / cache&#xa;  R : rid / rdata / rresp / rlast&#xa;&#xa;axiBurstAlwaysIncr=true → burst=INCR&#xa;writeNoError=true → 忽略 BRESP 错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="1525" y="200" width="155" height="260" as="geometry" />
    </mxCell>

    <!-- ===================== RX REQ Decoder (x=240, y=150) ===================== -->
    <mxCell id="rx_req" value="&lt;b&gt;RX REQ Decoder&lt;/b&gt;&#xa;解析 CHI REQ flit：&#xa;• 提取 Opcode / Addr / TxnID /&#xa;  SrcID / ReturnNID / MemAttr&#xa;• 区分操作类型：&#xa;  ReadNoSnp → 读路径&#xa;  WriteNoSnpFull → 写路径&#xa;  WriteNoSnpPtl → 写（含 ByteEn）&#xa;• OddParity 校验验证&#xa;• 分配 Outstanding Entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="240" y="155" width="195" height="170" as="geometry" />
    </mxCell>

    <!-- ===================== RX DAT Buffer (x=240, y=350) ===================== -->
    <mxCell id="rx_dat" value="&lt;b&gt;RX DAT Buffer（写数据接收）&lt;/b&gt;&#xa;接收 HN 发来的 NonCopyBackWrData：&#xa;• 多 beat 拼接（64B，最多 2 beat）&#xa;• 按 TxnID 与 Outstanding Entry 关联&#xa;• 收齐后通知写流水线: wdatReady=1&#xa;• 数据奇偶校验（OddParity）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="240" y="350" width="195" height="120" as="geometry" />
    </mxCell>

    <!-- ===================== Outstanding Transaction Buffer (OTB) (x=460, y=140) ===================== -->
    <mxCell id="otb_bg" value="Outstanding Transaction Buffer（OTB）" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="460" y="140" width="470" height="350" as="geometry" />
    </mxCell>
    <mxCell id="otb_entry" value="&lt;b&gt;每个 OTB Entry 字段：&lt;/b&gt;&#xa;  valid      : Bool         — 槽位占用&#xa;  entryID    : UInt         — 本地分配 ID（映射 AXI ARID/AWID）&#xa;  txnID      : UInt         — CHI TxnID（回填 RSP/DAT 用）&#xa;  srcID      : UInt         — CHI SrcID（RSP 发往目标）&#xa;  addr       : UInt(48.W)   — 请求物理地址&#xa;  isRead     : Bool         — 读(1) / 写(0) 标志&#xa;  dbidIssued : Bool         — DBIDResp 已发出&#xa;  wdatReady  : Bool         — 写数据已到达 RX DAT&#xa;  axiSent    : Bool         — AXI4 AR/AW+W 已发出&#xa;  axiDone    : Bool         — AXI4 R/B 响应已收到&#xa;  dataBuffer : Vec(8, UInt(64.W)) — 读数据暂存" style="text;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;whiteSpace=pre;" vertex="1" parent="otb_bg">
      <mxGeometry x="10" y="38" width="330" height="295" as="geometry" />
    </mxCell>
    <mxCell id="otb_ctrl" value="&lt;b&gt;Entry 分配 &amp; 释放：&lt;/b&gt;&#xa;• 空闲 Entry 分配给新 REQ&#xa;• OTB 满 → 发 RetryAck&#xa;• 读完成 / 写 Comp 后释放&#xa;LLC depth=64&#xa;MMIO depth=32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="otb_bg">
      <mxGeometry x="355" y="38" width="105" height="295" as="geometry" />
    </mxCell>

    <!-- ===================== Read Path (x=960, y=140) ===================== -->
    <mxCell id="read_path" value="读路径（ReadNoSnp）" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="960" y="140" width="430" height="310" as="geometry" />
    </mxCell>
    <mxCell id="rp1" value="&lt;b&gt;① AXI4 AR 发送&lt;/b&gt;&#xa;• 从 OTB 取出地址 / entryID&#xa;• burst=INCR（axiBurstAlwaysIncr）&#xa;• len = size / AXI总线宽度 - 1&#xa;• 将 entryID 写入 ARID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="read_path">
      <mxGeometry x="10" y="40" width="195" height="120" as="geometry" />
    </mxCell>
    <mxCell id="rp2" value="&lt;b&gt;② AXI4 R 数据接收&lt;/b&gt;&#xa;• 按 RID 匹配 OTB Entry&#xa;• 多 beat 拼接写入 dataBuffer&#xa;• rlast=1 → axiDone=1&#xa;• 触发 TX DAT 组装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="read_path">
      <mxGeometry x="220" y="40" width="195" height="120" as="geometry" />
    </mxCell>
    <mxCell id="rp3" value="&lt;b&gt;③ CHI CompData 发送&lt;/b&gt;&#xa;• 从 dataBuffer 取数据&#xa;• 按 CHI beat 拆分发出&#xa;  （512b → 最多 2 拍）&#xa;• 填入 TxnID / HomeNID&#xa;• 释放 OTB Entry&#xa;• OddParity 校验位生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="read_path">
      <mxGeometry x="10" y="185" width="195" height="115" as="geometry" />
    </mxCell>
    <!-- Read path internal arrows -->
    <mxCell id="rp12a" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="rp1" target="rp2" parent="read_path">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="rp23a" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="rp2" target="rp3" parent="read_path">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="317" y="162" />
          <mxPoint x="107" y="162" />
          <mxPoint x="107" y="185" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- ===================== Write Path (x=960, y=475) ===================== -->
    <mxCell id="write_path" value="写路径（WriteNoSnpFull）" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="960" y="475" width="430" height="330" as="geometry" />
    </mxCell>
    <mxCell id="wp1" value="&lt;b&gt;① CHI DBIDResp 发送&lt;/b&gt;&#xa;• 收到 WriteNoSnpFull REQ 后&#xa;• 立即返回 DBIDResp&#xa;• 向 HN 表示「准备好接收数据」&#xa;• MMIO: ReadReceipt 先于 DBIDResp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="write_path">
      <mxGeometry x="10" y="40" width="195" height="120" as="geometry" />
    </mxCell>
    <mxCell id="wp2" value="&lt;b&gt;② 等待 CHI 写数据&lt;/b&gt;&#xa;• 接收 HN DAT: NonCopyBackWrData&#xa;• RX DAT Buffer 拼接成完整行&#xa;• 通知 OTB: wdatReady=1&#xa;• writeCancelable=false →&#xa;  一旦分配不可撤销" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="write_path">
      <mxGeometry x="220" y="40" width="195" height="120" as="geometry" />
    </mxCell>
    <mxCell id="wp3" value="&lt;b&gt;③ AXI4 AW+W 发送&lt;/b&gt;&#xa;• wdatReady=1 后发 AW+W&#xa;• axiMasterOrder=WriteAddress&#xa;  → AW 严格先于 W（LLC 配置）&#xa;• axiMasterOrder=None&#xa;  → AW/W 可并行（MMIO 配置）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="write_path">
      <mxGeometry x="10" y="190" width="195" height="120" as="geometry" />
    </mxCell>
    <mxCell id="wp4" value="&lt;b&gt;④ AXI4 B 响应 + CHI Comp&lt;/b&gt;&#xa;• 收到 AXI4 B 通道的 bresp&#xa;• writeNoError=true →&#xa;  不上报 bresp 错误给 HN&#xa;• 向 HN 发 CHI Comp 响应&#xa;• 释放 OTB Entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="write_path">
      <mxGeometry x="220" y="190" width="195" height="120" as="geometry" />
    </mxCell>
    <!-- Write path internal arrows -->
    <mxCell id="wp12a" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="wp1" target="wp2" parent="write_path">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="wp23a" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="wp2" target="wp3" parent="write_path">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="317" y="165" />
          <mxPoint x="107" y="165" />
          <mxPoint x="107" y="190" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="wp34a" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="wp3" target="wp4" parent="write_path">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ===================== TX RSP/DAT Arbiter (x=460, y=530) ===================== -->
    <mxCell id="tx_arb" value="&lt;b&gt;TX RSP / TX DAT 仲裁发送&lt;/b&gt;&#xa;• RSP 队列：DBIDResp / Comp / CompDBIDResp / RetryAck&#xa;• DAT 队列：CompData（读数据，多 beat）&#xa;• 优先级：RSP &gt; DAT（避免 HN 超时）&#xa;• lcrdv 信用管理（CHI 流量控制）&#xa;• OddParity 校验位附加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="460" y="530" width="440" height="120" as="geometry" />
    </mxCell>

    <!-- ===================== AXI4 Channel Arbiter (x=960, y=840) ===================== -->
    <mxCell id="axi_arb" value="&lt;b&gt;AXI4 通道仲裁器&lt;/b&gt;&#xa;• AR 通道：多个读请求排队，按 ID 顺序发出&#xa;• AW / W 通道：写地址 + 数据顺序控制&#xa;  axiMasterOrder = WriteAddress → AW 先行（LLC 配置）&#xa;  axiMasterOrder = None → AW/W 可乱序（MMIO 配置）&#xa;• AXI ID 管理：entryID → ARID/AWID 映射，确保响应回溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="960" y="840" width="440" height="115" as="geometry" />
    </mxCell>

    <!-- ===================== Edges ===================== -->
    <!-- chi_port RX.REQ → rx_req -->
    <mxCell id="fe1" value="RX.REQ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;endArrow=block;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="chi_port" target="rx_req" parent="1">
      <mxGeometry relative="1" as="geometry" />
