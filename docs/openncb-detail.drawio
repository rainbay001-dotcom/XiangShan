    <!-- chi_port RX.DAT → rx_dat -->
    <mxCell id="fe2" value="RX.DAT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;endArrow=block;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="chi_port" target="rx_dat" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- rx_req → OTB (分配 Entry) -->
    <mxCell id="fe3" value="分配 Entry" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="rx_req" target="otb_bg" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <!-- rx_dat → OTB (写数据就绪) -->
    <mxCell id="fe4" value="写数据就绪" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" source="rx_dat" target="otb_bg" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- OTB → read_path (读请求) -->
    <mxCell id="fe5" value="读请求" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="otb_bg" target="read_path" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <!-- OTB → write_path (写请求) -->
    <mxCell id="fe6" value="写请求" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="otb_bg" target="write_path" parent="1">
