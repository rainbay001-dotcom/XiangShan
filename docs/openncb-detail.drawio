    <mxCell id="wp34" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;" edge="1" source="wp3" target="wp4" parent="write_path">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

