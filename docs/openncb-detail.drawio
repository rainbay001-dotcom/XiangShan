          <mxPoint x="1224" y="840" />
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- axi_arb → write_path (B 响应) -->
    <mxCell id="fe11b" value="B 响应" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;dashed=1;endArrow=open;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" source="axi_arb" target="write_path" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1268" y="840" />
          <mxPoint x="1268" y="817" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- axi_arb → axi_port (AXI4 Master) -->
    <mxCell id="fe12" value="AXI4 AR/AW/W" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;startArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="axi_arb" target="axi_port" parent="1">
      <mxGeometry relative="1" as="geometry">
