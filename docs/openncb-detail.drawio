    <mxCell id="fe9" value="TX RSP/DAT→HN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;dashed=1;endArrow=open;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" source="tx_arb" target="chi_port" parent="1">
      <mxGeometry relative="1" as="geometry">
