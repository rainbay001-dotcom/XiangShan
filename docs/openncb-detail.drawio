        </Array>
      </mxGeometry>
    </mxCell>
    <!-- axi_arb → read_path (R 数据返回) -->
    <mxCell id="fe10b" value="R 数据返回" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;dashed=1;endArrow=open;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" source="axi_arb" target="read_path" parent="1">
