    <mxCell id="ir5c" value="true（接受 Ordered 请求，保序语义）" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="1174" width="340" height="26" as="geometry"/></mxCell>

    <!-- ===================== Transaction Flow (Right side, y=1010) ===================== -->
    <mxCell id="flow_title" value="关键事务时序流程" style="text;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="880" y="1010" width="800" height="32" as="geometry" />
    </mxCell>
    <mxCell id="flow_read" value="&lt;b&gt;读事务（ReadNoSnp）&lt;/b&gt;&#xa;&#xa;OpenLLC(HN) → OpenNCB(SN) → DRAM&#xa;&#xa;① HN  TX.REQ: ReadNoSnp(addr, TxnID=T)&#xa;② SN  分配 OTB Entry，发 AXI4 AR(ARID=EntryID)&#xa;③ DRAM AXI4 R: data（rlast=1）&#xa;④ SN  组装 CompData：填 TxnID=T / HomeNID&#xa;⑤ SN  TX.DAT: CompData（512b，最多 2 拍）&#xa;⑥ HN  收到 CompData → 完成 Miss 处理" style="text;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="880" y="1042" width="385" height="180" as="geometry" />
    </mxCell>
    <mxCell id="flow_write" value="&lt;b&gt;写事务（WriteNoSnpFull）&lt;/b&gt;&#xa;&#xa;OpenLLC(HN) → OpenNCB(SN) → DRAM&#xa;&#xa;① HN  TX.REQ: WriteNoSnpFull(addr, TxnID=T)&#xa;② SN  分配 OTB Entry，发 TX.RSP: DBIDResp(DBID=EntryID)&#xa;③ HN  TX.DAT: NonCopyBackWrData(data, DBID)&#xa;④ SN  写数据到达：wdatReady=1&#xa;⑤ SN  AXI4 AW(AWID=EntryID) + W(data, last=1)&#xa;⑥ DRAM AXI4 B: bresp=OKAY&#xa;⑦ SN  TX.RSP: Comp(TxnID=T)&#xa;⑧ HN  收到 Comp → 完成写回处理" style="text;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="1285" y="1042" width="395" height="200" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
