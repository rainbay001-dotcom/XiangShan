    <!-- ===================== Two Instance Comparison Table ===================== -->
    <mxCell id="inst_title" value="XiangShan 中 OpenNCB 两类实例对比" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="20" y="920" width="800" height="35" as="geometry" />
