    <!-- write_path → tx_arb (DBIDResp + Comp) -->
    <mxCell id="fe8" value="DBIDResp/Comp" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" source="write_path" target="tx_arb" parent="1">
      <mxGeometry relative="1" as="geometry">
