    <mxCell id="ir2b" value="WriteAddress（AW 严格先于 W）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1096" width="290" height="26" as="geometry"/></mxCell>
