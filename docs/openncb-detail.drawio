<mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ===================== Page Title ===================== -->
    <mxCell id="t1" value="OpenNCB（非一致性 CHI→AXI4 桥）详细架构图 — XiangShan KunminghuV2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="150" y="20" width="1400" height="40" as="geometry" />
    </mxCell>

    <!-- ===================== Overview Annotation ===================== -->
    <mxCell id="overview" value="&lt;b&gt;OpenNCB 角色：&lt;/b&gt; CHI 协议的 SN（Slave Node），接收来自 OpenLLC（HN-F）发出的 ReadNoSnp / WriteNoSnpFull 等请求，&#xa;将其翻译为 AXI4 读/写事务发往 DRAM（或 MMIO 外设）。XiangShan 中部署两类实例：&#xa;① LLC Bridge（outstandingDepth=64，接 DDR/HBM 主存）  ② MMIO Bridge × NumCores（outstandingDepth=32，接外设总线）" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="70" width="1660" height="70" as="geometry" />
    </mxCell>

    <!-- ===================== CHI SN Interface (Left) ===================== -->
    <mxCell id="chi_label" value="CHI SN 接口&#xa;（来自 OpenLLC io.sn）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="180" width="150" height="60" as="geometry" />
    </mxCell>

    <mxCell id="chi_port" value="&lt;b&gt;CHI PortIO (SN 侧)&lt;/b&gt;&#xa;OpenNCB 以 &lt;b&gt;SN&lt;/b&gt; 身份接入 CHI 链路&#xa;&#xa;RX（OpenNCB 接收来自 HN 的请求）:&#xa;  REQ: flitv / flit(256b) / lcrdv&#xa;  DAT: flitv / flit(512b) / lcrdv&#xa;    （写数据：NonCopyBackWrData）&#xa;&#xa;TX（OpenNCB 发送响应给 HN）:&#xa;  RSP: flitv / flit(128b) / lcrdv&#xa;    （DBIDResp / Comp / CompDBIDResp）&#xa;  DAT: flitv / flit(512b) / lcrdv&#xa;    （CompData 读数据返回）&#xa;&#xa;链路控制：linkactive{req,ack} / rxsactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="20" y="260" width="200" height="240" as="geometry" />
    </mxCell>

    <!-- ===================== AXI4 Master Interface (Right) ===================== -->
    <mxCell id="axi_label" value="AXI4 主接口&#xa;（→ DRAM / MMIO）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1540" y="180" width="150" height="60" as="geometry" />
    </mxCell>

    <mxCell id="axi_port" value="&lt;b&gt;AXI4 Master Interface&lt;/b&gt;&#xa;OpenNCB 作为 AXI4 Master 发起读写&#xa;&#xa;写通道（W 方向）:&#xa;  AW: addr / id / len / burst / cache&#xa;       arlock / prot / size&#xa;  W : data(256b/512b) / strb / last&#xa;  B : bid / bresp（写响应）&#xa;&#xa;读通道（R 方向）:&#xa;  AR: addr / id / len / burst / cache&#xa;       arlock / prot / size&#xa;  R : rid / rdata / rresp / rlast&#xa;&#xa;注: axiBurstAlwaysIncr=true → burst=INCR&#xa;    writeNoError=true → 忽略 BRESP 错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="1490" y="260" width="200" height="260" as="geometry" />
    </mxCell>

    <!-- ===================== OpenNCB Top Frame ===================== -->
    <mxCell id="frame" value="OpenNCB 内部结构（CHI SN → AXI4 Master Bridge）" style="swimlane;startSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;swimlaneLine=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="160" width="1210" height="700" as="geometry" />
    </mxCell>

    <!-- ===================== CHI RX Path ===================== -->
    <!-- RX REQ Decoder -->
    <mxCell id="rx_req" value="&lt;b&gt;RX REQ Decoder&lt;/b&gt;&#xa;解析到达的 CHI REQ flit：&#xa;• 提取 Opcode / Addr / TxnID /&#xa;  SrcID / ReturnNID / MemAttr&#xa;• 区分操作类型：&#xa;  ReadNoSnp → 读路径&#xa;  WriteNoSnpFull → 写路径&#xa;  WriteNoSnpPtl → 写（带 ByteEn）&#xa;• 奇偶校验（OddParity）验证&#xa;• 发给 Outstanding Entry 分配器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="20" y="60" width="200" height="170" as="geometry" />
    </mxCell>

    <!-- RX DAT Buffer -->
    <mxCell id="rx_dat" value="&lt;b&gt;RX DAT Buffer（写数据接收）&lt;/b&gt;&#xa;接收来自 HN 的 NonCopyBackWrData：&#xa;• 多 beat 拼接（64B → 最多 2 beat）&#xa;• 按 TxnID 与 Outstanding Entry 关联&#xa;• 收齐后通知写流水线&#xa;• 数据奇偶校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="20" y="270" width="200" height="120" as="geometry" />
    </mxCell>

    <!-- ===================== Outstanding Transaction Buffer ===================== -->
    <mxCell id="otb_frame" value="Outstanding Transaction Buffer（OTB）" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="260" y="50" width="470" height="320" as="geometry" />
    </mxCell>

    <!-- OTB Entry detail -->
    <mxCell id="otb_entry" value="&lt;b&gt;每个 OTB Entry 字段：&lt;/b&gt;&#xa;  valid   : Bool  — 槽位占用&#xa;  entryID : UInt  — 本地分配 ID（映射 AXI AWID/ARID）&#xa;  txnID   : UInt  — CHI TxnID（用于 RSP/DAT 回填）&#xa;  srcID   : UInt  — CHI SrcID（返回 RSP 目标）&#xa;  addr    : UInt(48.W)  — 请求地址&#xa;  isRead  : Bool  — 读(1) / 写(0) 标志&#xa;  dbidIssued : Bool — DBIDResp 已发出&#xa;  wdatReady  : Bool — 写数据已到达&#xa;  axiSent    : Bool — AXI4 请求已发出&#xa;  axiDone    : Bool — AXI4 响应已收到&#xa;  dataBuffer : Vec(UInt(64.W), 8) — 读数据暂存" style="text;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="10" y="40" width="340" height="265" as="geometry" />
    </mxCell>

    <!-- OTB Alloc/Free Control -->
    <mxCell id="otb_ctrl" value="&lt;b&gt;Entry 分配 &amp; 释放：&lt;/b&gt;&#xa;• 空闲 Entry 分配给新 REQ&#xa;• OTB 满 → 向 HN 发 RetryAck&#xa;• 读完成 / 写 Comp 后释放&#xa;  outstandingDepth: 64(LLC) / 32(MMIO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="360" y="40" width="100" height="265" as="geometry" />
    </mxCell>

    <!-- ===================== Read Path ===================== -->
    <mxCell id="read_path" value="读路径（ReadNoSnp）" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="760" y="50" width="420" height="300" as="geometry" />
    </mxCell>

    <mxCell id="rp1" value="&lt;b&gt;① AXI4 AR 发送&lt;/b&gt;&#xa;• 从 OTB 取出地址 / entryID&#xa;• axiBurstAlwaysIncr=true → burst=INCR&#xa;• len = (数据宽度-1)/AXI总线宽度&#xa;• 将 entryID 写入 ARID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="10" y="38" width="190" height="110" as="geometry" />
    </mxCell>

    <mxCell id="rp2" value="&lt;b&gt;② AXI4 R 数据接收&lt;/b&gt;&#xa;• 按 RID 匹配 OTB Entry&#xa;• 多 beat 拼接写入 dataBuffer&#xa;• rlast=1 时标记 axiDone&#xa;• 触发 TX DAT 组装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="210" y="38" width="190" height="110" as="geometry" />
    </mxCell>

    <mxCell id="rp3" value="&lt;b&gt;③ CHI CompData 发送&lt;/b&gt;&#xa;• 从 dataBuffer 取数据&#xa;• 按 CHI beat 拆分发出&#xa;  （512b → 最多 2 拍）&#xa;• 填入 TxnID / HomeNID&#xa;• 释放 OTB Entry&#xa;• 奇偶校验位生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="10" y="175" width="190" height="115" as="geometry" />
    </mxCell>

    <!-- ===================== Write Path ===================== -->
    <mxCell id="write_path" value="写路径（WriteNoSnpFull）" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="760" y="380" width="420" height="310" as="geometry" />
    </mxCell>

    <mxCell id="wp1" value="&lt;b&gt;① CHI DBIDResp 发送&lt;/b&gt;&#xa;• 收到 WriteNoSnpFull REQ 后&#xa;• 立即返回 DBIDResp（写缓冲 ID）&#xa;• 向 HN 表示「已准备好接收数据」&#xa;• readReceiptAfterAcception(MMIO) →&#xa;  ReadReceipt 先于 DBIDResp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="10" y="40" width="190" height="120" as="geometry" />
    </mxCell>

    <mxCell id="wp2" value="&lt;b&gt;② 等待 CHI 写数据&lt;/b&gt;&#xa;• 接收 HN 发来的 DAT flit&#xa;  （NonCopyBackWrData）&#xa;• RX DAT Buffer 拼接成完整行&#xa;• 通知 OTB Entry: wdatReady=1&#xa;• writeCancelable=false →&#xa;  一旦分配不可撤销" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="210" y="40" width="190" height="120" as="geometry" />
    </mxCell>

    <mxCell id="wp3" value="&lt;b&gt;③ AXI4 AW+W 发送&lt;/b&gt;&#xa;• wdatReady=1 后发出 AW+W&#xa;• axiMasterOrder 控制顺序：&#xa;  WriteAddress → AW 先于 W&#xa;  None → AW/W 可并行（MMIO）&#xa;• W 通道：data / strb / last&#xa;• 写数据按 AXI 总线宽度切分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="10" y="180" width="190" height="120" as="geometry" />
    </mxCell>

    <mxCell id="wp4" value="&lt;b&gt;④ AXI4 B 响应 + CHI Comp&lt;/b&gt;&#xa;• AXI4 B 通道收到 bresp&#xa;• writeNoError=true →&#xa;  不上报 bresp 错误给 HN&#xa;• 向 HN 发 CHI Comp 响应&#xa;  （写事务完成确认）&#xa;• 释放 OTB Entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="210" y="180" width="190" height="120" as="geometry" />
    </mxCell>

    <!-- Write path arrows -->
    <mxCell id="wp12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;" edge="1" source="wp1" target="wp2" parent="write_path">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="wp13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;endArrow=block;" edge="1" source="wp2" target="wp3" parent="write_path">
      <mxGeometry relative="1" as="geometry">
