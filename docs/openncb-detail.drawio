          <mxPoint x="228" y="360" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- read_path → axi_arb (AR) -->
    <mxCell id="fe10" value="AR 发出" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;endArrow=block;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="read_path" target="axi_arb" parent="1">
