    <mxCell id="ih0" value="参数" style="text;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="955" width="180" height="30" as="geometry"/></mxCell>
    <mxCell id="ih1" value="LLC Bridge（内存主存）" style="text;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="955" width="280" height="30" as="geometry"/></mxCell>
    <mxCell id="ih2" value="MMIO Bridge × N（外设）" style="text;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="955" width="340" height="30" as="geometry"/></mxCell>

    <mxCell id="ir1a" value="outstandingDepth" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="985" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir1b" value="64" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="985" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir1c" value="32" style="text;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="985" width="340" height="28" as="geometry"/></mxCell>

    <mxCell id="ir2a" value="axiMasterOrder" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1013" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir2b" value="WriteAddress（AW 严格先于 W）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1013" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir2c" value="None（AW/W 可以乱序，提升并发）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1013" width="340" height="28" as="geometry"/></mxCell>

    <mxCell id="ir3a" value="readCompDMT" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1041" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir3b" value="false（直接 CompData，不用 DMT 转发）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1041" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir3c" value="false" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1041" width="340" height="28" as="geometry"/></mxCell>

    <mxCell id="ir4a" value="asEndpoint" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1069" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir4b" value="true（默认，终端节点模式）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1069" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir4c" value="false（非终端节点，支持 Order 端点）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1069" width="340" height="28" as="geometry"/></mxCell>

    <mxCell id="ir5a" value="acceptOrderEndpoint" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1097" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir5b" value="false" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1097" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir5c" value="true（接受 Ordered 请求，保序语义）" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1097" width="340" height="28" as="geometry"/></mxCell>

    <mxCell id="ir6a" value="acceptMemAttrDevice" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1125" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir6b" value="false（仅接受 Normal 类型内存属性）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1125" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir6c" value="true（接受 Device 类内存属性，用于外设访问）" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1125" width="340" height="28" as="geometry"/></mxCell>

    <mxCell id="ir7a" value="readReceiptAfterAcception" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1153" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir7b" value="false" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1153" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir7c" value="true（ReadReceipt 在接受后立即返回，减少延迟）" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1153" width="340" height="28" as="geometry"/></mxCell>

    <mxCell id="ir8a" value="chiDataCheck" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1181" width="180" height="28" as="geometry"/></mxCell>
    <mxCell id="ir8b" value="OddParity（CHI DAT flit 奇偶校验）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1181" width="280" height="28" as="geometry"/></mxCell>
    <mxCell id="ir8c" value="OddParity（相同）" style="text;html=1;fillColor=#fff;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1181" width="340" height="28" as="geometry"/></mxCell>

    <!-- ===================== Transaction Flow Summary ===================== -->
    <mxCell id="flow_title" value="关键事务时序流程（LLC Bridge 读写场景）" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="870" y="920" width="810" height="35" as="geometry" />
    </mxCell>

    <mxCell id="flow_read" value="&lt;b&gt;读事务时序（ReadNoSnp）&lt;/b&gt;&#xa;&#xa;OpenLLC(HN)  →  OpenNCB(SN)  →  DRAM&#xa;&#xa;① HN  TX.REQ: ReadNoSnp(addr, TxnID=T)&#xa;② SN  TX.RSP: CompData (等待内存返回后)&#xa;             同时发 AXI4 AR(addr, ARID=EntryID)&#xa;③ DRAM AXI4 R: data (rlast=1)&#xa;④ SN  TX.DAT: CompData(data, TxnID=T, HomeNID)&#xa;⑤ HN  收到 CompData → 完成 Miss 处理" style="text;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="870" y="960" width="390" height="250" as="geometry" />
    </mxCell>

    <mxCell id="flow_write" value="&lt;b&gt;写事务时序（WriteNoSnpFull）&lt;/b&gt;&#xa;&#xa;OpenLLC(HN)  →  OpenNCB(SN)  →  DRAM&#xa;&#xa;① HN  TX.REQ: WriteNoSnpFull(addr, TxnID=T)&#xa;② SN  TX.RSP: DBIDResp(DBID=EntryID)&#xa;③ HN  TX.DAT: NonCopyBackWrData(data, DBID)&#xa;④ SN  等待写数据到达（wdatReady=1）&#xa;⑤ SN  AXI4 AW(addr, AWID=EntryID)&#xa;        AXI4 W(data, strb, last=1)&#xa;⑥ DRAM AXI4 B: bresp=OKAY&#xa;⑦ SN  TX.RSP: Comp(TxnID=T)&#xa;⑧ HN  收到 Comp → 完成写回处理" style="text;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="1280" y="960" width="400" height="290" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
