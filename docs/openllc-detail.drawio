    <mxCell id="e7" value="S1读/S3写" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#375623;endArrow=block;startArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s3" target="data" parent="1">
      <mxGeometry relative="1" as="geometry">
