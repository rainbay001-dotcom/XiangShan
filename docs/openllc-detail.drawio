    <!-- MSHR → SnoopUnit (触发Snoop) -->
    <mxCell id="e9" value="触发Snoop" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8B2C28;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="mshr" target="snoop" parent="1">
