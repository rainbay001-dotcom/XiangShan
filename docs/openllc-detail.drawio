      </mxGeometry>
    </mxCell>

    <!-- nodeID/l3Miss arrows pointing upward to indicate they're inputs -->
    <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8B2C28;endArrow=open;dashed=1;" edge="1" source="nodeID" target="resp" parent="1">
