<mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1600" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ===================== Title ===================== -->
    <mxCell id="t1" value="OpenLLC (HN-F) 详细架构图 — XiangShan KunminghuV2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="1660" height="40" as="geometry" />
    </mxCell>

    <!-- ===================== RN Ports (Left, y=70..440) ===================== -->
    <mxCell id="rn_label" value="CHI RN 上行接口&#xa;io.rn[0..N]" style="text;html=1;fillColor=#737373;strokeColor=#4D4D4D;align=center;fontStyle=1;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="20" y="70" width="160" height="40" as="geometry" />
    </mxCell>
    <mxCell id="rn0" value="&lt;b&gt;io.rn[0]&lt;/b&gt;&#xa;Core 0 / CHIHNSubNode&#xa;TX: REQ(256b)/RSP(128b)/DAT(512b)&#xa;RX: SNP(256b)/RSP(128b)/DAT(512b)&#xa;linkactive* / rxsactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8B7000;strokeColor=#6B5600;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="20" y="120" width="160" height="110" as="geometry" />
    </mxCell>
    <mxCell id="rn1" value="&lt;b&gt;io.rn[1]&lt;/b&gt;&#xa;Core 1 / CHIHNSubNode&#xa;TX: REQ(256b)/RSP(128b)/DAT(512b)&#xa;RX: SNP(256b)/RSP(128b)/DAT(512b)&#xa;linkactive* / rxsactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8B7000;strokeColor=#6B5600;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="20" y="240" width="160" height="110" as="geometry" />
    </mxCell>
    <mxCell id="rnN" value="&lt;b&gt;io.rn[N]&lt;/b&gt;（可选）&#xa;双 Socket XSBridge&#xa;numRNs = NumCores + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B5651D;strokeColor=#8B4500;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="20" y="370" width="160" height="80" as="geometry" />
    </mxCell>

    <!-- ===================== RequestBuffer + RequestArbiter (x=200) ===================== -->
    <mxCell id="rb" value="&lt;b&gt;RequestBuffer&lt;/b&gt;&#xa;接收各 RN REQ/SNP flit&#xa;按 srcID 排队，流控&#xa;lcrdv 信用计数回流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#2E5496;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="200" y="130" width="160" height="80" as="geometry" />
    </mxCell>
    <mxCell id="ra" value="&lt;b&gt;RequestArbiter&lt;/b&gt;&#xa;多路优先级仲裁：&#xa;① 新请求（来自 RB）&#xa;② MSHR retry 请求&#xa;③ Snoop 二次请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#2E5496;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="200" y="250" width="160" height="100" as="geometry" />
    </mxCell>

    <!-- ===================== MainPipe (swimlane container, x=385..1035, y=80..390) ===================== -->
    <!-- S1-S4 are children with relative coords; inter-stage arrows are also relative -->
    <mxCell id="pipe_bg" value="MainPipe（主流水线，4 级）" style="swimlane;startSize=28;fillColor=#7B5EA7;strokeColor=#5C3D7A;fontStyle=1;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="390" y="80" width="650" height="320" as="geometry" />
    </mxCell>
    <mxCell id="s1" value="&lt;b&gt;S1：地址解码 &amp; 索引&lt;/b&gt;&#xa;• 物理地址拆分：&#xa;  Bank[1:0] / Set[10:0] / Tag&#xa;• 发起 Directory SRAM 读&#xa;• 发起 DataStorage SRAM 读&#xa;• 生成 Way 选择候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B5EA7;strokeColor=#5C3D7A;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="pipe_bg">
      <mxGeometry x="10" y="40" width="150" height="270" as="geometry" />
    </mxCell>
    <mxCell id="s2" value="&lt;b&gt;S2：命中判定 &amp; 一致性决策&lt;/b&gt;&#xa;• tag 比对 → hit / miss&#xa;• 读取 State: I/SC/UC/UD/SD&#xa;• 确定操作类型：&#xa;  ReadShared / WriteBack / MakeUnique&#xa;• Miss：分配 MSHR 槽位&#xa;• Hit：准备 S3 直接响应&#xa;• 判断是否需要 Snoop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B5EA7;strokeColor=#5C3D7A;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="pipe_bg">
      <mxGeometry x="170" y="40" width="150" height="270" as="geometry" />
    </mxCell>
    <mxCell id="s3" value="&lt;b&gt;S3：数据 &amp; 目录写回&lt;/b&gt;&#xa;• 命中读：从 DataSRAM 取数&#xa;  → 生成 CompData 发 RN&#xa;• 命中写：更新 DataSRAM&#xa;  + 更新 Directory State&#xa;• 缺失：写入 MSHR，等待：&#xa;  (a) Snoop 响应聚合&#xa;  (b) SN CompData 回填&#xa;• WB/Evict：无效化 + 释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B5EA7;strokeColor=#5C3D7A;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="pipe_bg">
      <mxGeometry x="320" y="40" width="150" height="270" as="geometry" />
    </mxCell>
    <mxCell id="s4" value="&lt;b&gt;S4：提交 &amp; 响应分发&lt;/b&gt;&#xa;• 向 ResponseUnit 发送：&#xa;  Comp / CompData /&#xa;  CompAck / DBIDResp&#xa;• 向 SnoopUnit 触发 Snoop&#xa;• 更新 MSHR 状态机&#xa;• 流水线反压（hazard）&#xa;  相同 Set 需等待前序完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B5EA7;strokeColor=#5C3D7A;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="pipe_bg">
      <mxGeometry x="480" y="40" width="150" height="270" as="geometry" />
    </mxCell>
    <!-- Pipeline inter-stage arrows (relative to pipe_bg) -->
    <mxCell id="ps12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C3D7A;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s1" target="s2" parent="pipe_bg">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="ps23" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C3D7A;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s2" target="s3" parent="pipe_bg">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="ps34" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C3D7A;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s3" target="s4" parent="pipe_bg">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ===================== TX Arbiter + RX Handler (x=1060) ===================== -->
    <mxCell id="tx_arb" value="&lt;b&gt;TX Arbiter（发送仲裁）&lt;/b&gt;&#xa;向 io.sn（OpenNCB）输出：&#xa;• REQ：ReadNoSnp / WriteNoSnpFull&#xa;• DAT：NonCopyBackWrData&#xa;向各 RN 输出：&#xa;• RSP：Comp / DBIDResp / RetryAck&#xa;• DAT：CompData / RespSepData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#375623;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="1060" y="100" width="240" height="140" as="geometry" />
    </mxCell>
    <mxCell id="rx_hdlr" value="&lt;b&gt;RX Handler（下行接收）&lt;/b&gt;&#xa;从 io.sn 接收来自 OpenNCB 的响应：&#xa;• RX.RSP：Comp / DBIDResp&#xa;  → 通知 MSHR 内存写完成&#xa;• RX.DAT：CompData（内存读数据）&#xa;  → 送往 RefillBuffer 处理&#xa;lcrdv 信用回流控制发送速率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#375623;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="1060" y="260" width="240" height="130" as="geometry" />
    </mxCell>

    <!-- ===================== SN Port (Right, x=1320) ===================== -->
    <mxCell id="sn_label" value="CHI SN 下行接口&#xa;io.sn → OpenNCB" style="text;html=1;fillColor=#737373;strokeColor=#4D4D4D;align=center;fontStyle=1;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="1320" y="70" width="160" height="40" as="geometry" />
    </mxCell>
    <mxCell id="sn" value="&lt;b&gt;io.sn&lt;/b&gt;&#xa;（→ OpenNCB LLC Bridge）&#xa;TX: REQ(256b) / DAT(512b)&#xa;RX: RSP(128b) / DAT(512b)&#xa;（OpenLLC 作为 Requester&#xa;向 SN 发起内存读写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#375623;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="1320" y="120" width="160" height="140" as="geometry" />
    </mxCell>

    <!-- ===================== Middle Row: Storage Modules (y=430) ===================== -->
    <mxCell id="mshr" value="&lt;b&gt;MSHR Array（未命中状态保持寄存器）&lt;/b&gt;&#xa;每项跟踪一个 in-flight 缺失事务：&#xa;• addr / opcode / srcID / txnID&#xa;• state : 等待 Snoop / 等待内存 / 等待 CompAck…&#xa;• gotPendingSnp : Vec(numRNs.W) — Snoop 收齐位图&#xa;• gotDirtyData : Bool — 脏数据已收到&#xa;• dataBuffer : UInt(512.W) — 数据暂存&#xa;MSHR 满 → 向 RN 返回 RetryAck（反压）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8B7000;strokeColor=#6B5600;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="20" y="430" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="dir" value="&lt;b&gt;Directory（目录 SRAM）&lt;/b&gt;&#xa;每 Cacheline 条目：&#xa;• valid : Bool&#xa;• tag   : UInt(tagBits.W)&#xa;• state : CHI State（5 bits）&#xa;  I / SC / UC / UD / SD&#xa;• clients : UInt(numRNs.W) — Sharer 位图&#xa;容量：8ways × 2048sets × 4banks = 524,288 项&#xa;S1 读 → S3/S4 写（单口 SRAM）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B5EA7;strokeColor=#5C3D7A;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="310" y="430" width="290" height="180" as="geometry" />
    </mxCell>
    <mxCell id="data" value="&lt;b&gt;DataStorage（数据 SRAM）&lt;/b&gt;&#xa;• 每行 512-bit（64B per cacheline）&#xa;• 总容量：8w × 2048s × 4b × 64B = 4MB&#xa;• 分 bank 并行，减少访问冲突&#xa;• 支持 OddParity 数据校验&#xa;  （chiDataCheck 参数控制）&#xa;• S1 发读请求，S3 读结果 / 写数据&#xa;• RefillBuffer 回填后写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#375623;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="610" y="430" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="refill" value="&lt;b&gt;RefillBuffer（回填缓冲）&lt;/b&gt;&#xa;接收 SN (OpenNCB→DRAM) 返回的&#xa;CompData flit：&#xa;• 将 data 写入 DataStorage&#xa;• 更新对应 MSHR 的 dataBuffer&#xa;• 触发 MSHR 后续处理流程&#xa;  （组装 CompData 发 RN&#xa;   或先 Snoop 再转发）&#xa;• 支持多拍 Beat 拼接（512b）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#375623;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="900" y="430" width="260" height="180" as="geometry" />
    </mxCell>

    <!-- ===================== Bottom Row: Snoop + Response (y=640) ===================== -->
    <mxCell id="snoop" value="&lt;b&gt;SnoopUnit（Snoop 发射单元）&lt;/b&gt;&#xa;根据 MSHR + Directory Sharer 位图&#xa;生成 Snoop 命令发往 RN.RX.SNP：&#xa;• SnpShared      — 降权共享&#xa;• SnpUnique      — 独占/无效化&#xa;• SnpCleanInvalid — 强制无效化&#xa;• SnpMakeInvalid — 快速无效化&#xa;收集所有 SnpResp / SnpRespData：&#xa;• 更新 MSHR.gotPendingSnp 位图&#xa;• 携带脏数据 → 写入 DataStorage&#xa;全部 Snoop 响应到齐 → 解锁 MSHR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0504D;strokeColor=#8B2C28;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="20" y="640" width="280" height="200" as="geometry" />
    </mxCell>
    <mxCell id="resp" value="&lt;b&gt;ResponseUnit（响应组装单元）&lt;/b&gt;&#xa;从 MainPipe S4 / MSHR 接收指令，&#xa;组装 CHI 响应 flit 并发往 RN：&#xa;• Comp         — 写入/权限转换完成&#xa;• CompData     — 读命中时附数据&#xa;• CompAck      — 等待 RN Ack 确认&#xa;• RespSepData  — 先响应后发数据&#xa;• DBIDResp     — 写数据缓冲分配&#xa;• RetryAck     — 反压（MSHR 满）&#xa;也向 SN 发 ReadNoSnp / WriteNoSnpFull" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0504D;strokeColor=#8B2C28;fontSize=10;align=left;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="310" y="640" width="290" height="200" as="geometry" />
    </mxCell>

    <!-- ===================== Bottom Ports (y=870) ===================== -->
    <mxCell id="nodeID" value="io.nodeID : UInt&#xa;= NumCores × 2&#xa;（本 HN 节点 ID）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0504D;strokeColor=#8B2C28;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="310" y="870" width="150" height="70" as="geometry" />
    </mxCell>
    <mxCell id="l3Miss" value="io.l3Miss : Bool&#xa;（L3 缺失脉冲信号&#xa;→ 核心 l3MissMatch）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0504D;strokeColor=#8B2C28;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="480" y="870" width="150" height="70" as="geometry" />
    </mxCell>

