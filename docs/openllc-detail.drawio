    <mxCell id="r1c0" value="互联协议" style="text;html=1;fillColor=#737373;strokeColor=#4D4D4D;fontSize=10;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="150" height="30" as="geometry"/></mxCell>
