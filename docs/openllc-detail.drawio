    <!-- RequestBuffer → RequestArbiter -->
    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E5496;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="rb" target="ra" parent="1">
      <mxGeometry relative="1" as="geometry" />
