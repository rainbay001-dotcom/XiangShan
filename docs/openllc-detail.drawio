    <mxCell id="portio_title" value="PortIO（CHI E.b 11-bit NodeID）信号明细" style="text;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontStyle=1;fontSize=11;" vertex="1" parent="1">
