    <mxCell id="params" value="case class OpenLLCParam(&#xa;  name           : String  = &quot;LLC&quot;,&#xa;  ways           : Int     = 8,       // 缓存路数&#xa;  sets           : Int     = 2048,    // 每 bank 组数&#xa;  banks          : Int     = 4,       // Bank 数 → 总 4MB&#xa;  fullAddressBits: Int     = 48,      // sv48 物理地址宽度&#xa;  clientCaches   : Seq[L2Param],      // 各 L2 参数&#xa;  hartIds        : Seq[Int] = Nil,    // 由 tiles 填入&#xa;  FPGAPlatform   : Boolean  = false,&#xa;  enablePerf     : Boolean  = false,  // 性能计数器开关&#xa;)" style="text;html=1;align=left;verticalAlign=top;fillColor=#4472C4;strokeColor=#2E5496;fontFamily=Courier New;fontSize=10;whiteSpace=pre;fontColor=#FFFFFF;" vertex="1" parent="1">
