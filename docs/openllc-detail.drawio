    <!-- ===================== OpenLLC Parameter Box ===================== -->
    <mxCell id="param_title" value="OpenLLCParam 核心参数一览" style="text;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="840" y="800" width="500" height="30" as="geometry" />
    </mxCell>
    <mxCell id="params" value="case class OpenLLCParam(&#xa;  name           : String  = &quot;LLC&quot;,&#xa;  ways           : Int     = 8,        // 缓存路数&#xa;  sets           : Int     = 2048,     // 每 bank 组数（生产配置 2K 组）&#xa;  banks          : Int     = 4,        // Bank 数 → 总容量 = w×s×b×64B = 4MB&#xa;  fullAddressBits: Int     = 48,       // sv48 物理地址宽度&#xa;  clientCaches   : Seq[L2Param],       // 各 L2 的参数（用于 Directory shadow tag）&#xa;  hartIds        : Seq[Int]= Nil,      // 运行时由 tiles.map(_.HartId) 填入&#xa;  FPGAPlatform   : Boolean = false,    // FPGA 模式（关闭仿真断言等）&#xa;  enablePerf     : Boolean = false,    // 性能计数器开关&#xa;  elaboratedTopDown: Boolean = false   // Top-Down 分析信号开关&#xa;)" style="text;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;whiteSpace=pre;" vertex="1" parent="1">
      <mxGeometry x="840" y="830" width="500" height="260" as="geometry" />
    </mxCell>

