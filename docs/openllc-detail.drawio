        </Array>
      </mxGeometry>
    </mxCell>

    <!-- SnoopUnit → RN0 (SNP→RN, dashed) -->
    <mxCell id="e11" value="SNP→RN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8B2C28;dashed=1;endArrow=open;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" source="snoop" target="rn0" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="10" y="740" />
          <mxPoint x="10" y="230" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- ResponseUnit → TX Arbiter (RSP/DAT for RN nodes) -->
    <mxCell id="e11b" value="RSP/DAT for RN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#548235;endArrow=block;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="resp" target="tx_arb" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="610" y="780" />
          <mxPoint x="1050" y="780" />
          <mxPoint x="1050" y="198" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- TX Arbiter → io.rn[0..N] (RSP/DAT output back to all RN nodes via tx.rsp / tx.dat) -->
    <mxCell id="e_ta_rn" value="RSP/DAT→io.rn[0..N]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#548235;fontStyle=1;fontSize=9;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" source="tx_arb" target="rn0" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1050" y="170" />
          <mxPoint x="1050" y="600" />
          <mxPoint x="10" y="600" />
          <mxPoint x="10" y="230" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- RefillBuffer → DataStorage (回填写入) -->
    <mxCell id="e12" value="回填写入" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#375623;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="refill" target="data" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- RefillBuffer → MSHR (数据就绪) -->
    <mxCell id="e12b" value="数据就绪" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B5600;endArrow=open;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="refill" target="mshr" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="890" y="480" />
          <mxPoint x="310" y="480" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- ResponseUnit → TxArb (向SN发REQ/DAT) -->
    <mxCell id="e15c" value="REQ/DAT for SN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#375623;endArrow=block;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="resp" target="tx_arb" parent="1">
      <mxGeometry relative="1" as="geometry">
