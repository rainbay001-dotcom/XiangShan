    <!-- ===================== Page Title ===================== -->
    <mxCell id="t1" value="OpenLLC (HN-F) 详细架构图 — XiangShan KunminghuV2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="20" width="1300" height="40" as="geometry" />
    </mxCell>

    <!-- ===================== OpenLLC Top Frame ===================== -->
    <mxCell id="frame" value="OpenLLC（HN-F — Home Node Fully Coherent）&#xa;CHI 版末级缓存 L3，替代 TileLink 时代的 HuanCun" style="swimlane;startSize=55;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneLine=1;" vertex="1" parent="1">
      <mxGeometry x="340" y="80" width="1080" height="760" as="geometry" />
    </mxCell>

    <!-- ===================== CHI RN-F Ports (Left) ===================== -->
    <!-- RN-F header label -->
    <mxCell id="rn_label" value="CHI RN-F 上行接口&#xa;io.rn[0..N-1]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="20" y="200" width="150" height="60" as="geometry" />
    </mxCell>

    <!-- RN port 0 -->
    <mxCell id="rn0" value="&lt;b&gt;io.rn[0]&lt;/b&gt;&#xa;（Core 0 L2）&#xa;PortIO — CHI E.b&#xa;TX: REQ / RSP / DAT&#xa;RX: SNP / RSP / DAT&#xa;+ linkactive 信号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="280" width="150" height="110" as="geometry" />
    </mxCell>

    <!-- RN port 1 -->
    <mxCell id="rn1" value="&lt;b&gt;io.rn[1]&lt;/b&gt;&#xa;（Core 1 L2）&#xa;PortIO — CHI E.b&#xa;TX: REQ / RSP / DAT&#xa;RX: SNP / RSP / DAT&#xa;+ linkactive 信号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="410" width="150" height="110" as="geometry" />
    </mxCell>

    <!-- RN port N (bridge inject for two-socket) -->
    <mxCell id="rnN" value="&lt;b&gt;io.rn[N]&lt;/b&gt;（可选）&#xa;双 Socket 时:&#xa;XSBridge inject 端口&#xa;虚拟第 N+1 号核&#xa;numRNs = NumCores+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="540" width="150" height="100" as="geometry" />
    </mxCell>

    <!-- ===================== SN Port (Right) ===================== -->
    <mxCell id="sn_label" value="CHI SN 下行接口&#xa;io.sn → OpenNCB" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1490" y="200" width="150" height="60" as="geometry" />
    </mxCell>
    <mxCell id="sn" value="&lt;b&gt;io.sn&lt;/b&gt;&#xa;（→ OpenNCB LLC Bridge）&#xa;PortIO — CHI E.b&#xa;TX: REQ / DAT&#xa;RX: RSP / DAT&#xa;（OpenLLC 作为 Requester&#xa; 向 SN 发起内存读写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1490" y="280" width="150" height="130" as="geometry" />
    </mxCell>

    <!-- ===================== Bottom Ports ===================== -->
    <mxCell id="nodeID" value="io.nodeID : UInt&#xa;= NumCores × 2&#xa;（本 HN 节点 ID）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="380" y="1000" width="150" height="70" as="geometry" />
    </mxCell>
    <mxCell id="l3Miss" value="io.l3Miss : Bool&#xa;（L3 缺失脉冲信号&#xa;→ 核心 l3MissMatch）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="1000" width="150" height="70" as="geometry" />
    </mxCell>
    <mxCell id="debug" value="io.debugTopDown&#xa;.robHeadPaddr[i] : Vec(UInt)  ← 输入&#xa;.addrMatch[i] : Vec(Bool)      → 输出&#xa;（Top-Down 分析用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="740" y="1000" width="250" height="70" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: RequestBuffer ===================== -->
    <mxCell id="rb" value="&lt;b&gt;RequestBuffer&lt;/b&gt;&#xa;接收并缓冲来自各 RN 的&#xa;REQ/SNP 通道 flit&#xa;按 NodeID 分类入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="380" y="120" width="170" height="80" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: RequestArbiter ===================== -->
    <mxCell id="ra" value="&lt;b&gt;RequestArbiter&lt;/b&gt;&#xa;多路仲裁器：&#xa;• 来自 RB 的新请求&#xa;• MSHR 的重试请求 (Retry)&#xa;• Snoop 产生的二次请求&#xa;输出送往主流水线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="580" y="110" width="175" height="100" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: MainPipeline ===================== -->
    <mxCell id="pipe_frame" value="MainPipe（主流水线）" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="790" y="100" width="450" height="200" as="geometry" />
    </mxCell>
    <mxCell id="s1" value="S1：地址解码&#xa;Bank 路由&#xa;Tag 索引计算&#xa;Directory 发送读请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="10" y="40" width="130" height="80" as="geometry" />
    </mxCell>
    <mxCell id="s2" value="S2：Directory 读结果&#xa;缓存命中/缺失判断&#xa;Coherency 状态机决策&#xa;（Hit / Miss / Snoop?）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="40" width="130" height="80" as="geometry" />
    </mxCell>
    <mxCell id="s3" value="S3：Data SRAM 读/写&#xa;Directory 更新&#xa;生成 Comp/CompData&#xa;or 发 MSHR 入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="40" width="130" height="80" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: Directory ===================== -->
    <mxCell id="dir" value="&lt;b&gt;Directory（目录 SRAM）&lt;/b&gt;&#xa;每 Cacheline 存储：&#xa;• 有效位 / Tag&#xa;• 本地 State（Invalid/Shared/Exclusive/Modified）&#xa;• 客户端 Sharer 向量（per L2 hartId）&#xa;容量 = ways × sets × banks&#xa;（默认: 8w × 2048s × 4b = 524288 项）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="790" y="340" width="280" height="130" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: DataStorage ===================== -->
    <mxCell id="data" value="&lt;b&gt;DataStorage（数据 SRAM）&lt;/b&gt;&#xa;分 banks 存储缓存行数据&#xa;每行 512-bit (64B)&#xa;总容量 = ways × sets × banks × 64B&#xa;（默认: 8w × 2048s × 4b × 64B = 4MB）&#xa;支持 ECC / 奇偶校验（配置决定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1090" y="340" width="270" height="130" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: MSHRs ===================== -->
    <mxCell id="mshr" value="&lt;b&gt;MSHR Array（未命中状态保持寄存器）&lt;/b&gt;&#xa;追踪所有 in-flight 缺失事务：&#xa;• 原始请求信息（来源 NodeID、地址、操作码）&#xa;• 当前等待状态（等 Snoop 响应 / 等内存数据）&#xa;• Snoop 完成跟踪位图&#xa;• 内存返回数据缓冲&#xa;MSHR 满时向 RN 返回 RetryAck（反压）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="580" y="340" width="185" height="150" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: SnoopUnit ===================== -->
    <mxCell id="snoop" value="&lt;b&gt;SnoopUnit（Snoop 发射单元）&lt;/b&gt;&#xa;根据 MSHR 的状态和 Directory 的&#xa;Sharer 信息，生成 Snoop 命令：&#xa;• SnpShared / SnpCleanInvalid&#xa;• SnpUnique / SnpMakeInvalid&#xa;发往相关 RN 的 RX.SNP 通道&#xa;收集 SnpResp / SnpRespData 并回填 MSHR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="580" y="530" width="195" height="140" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: ResponseUnit ===================== -->
    <mxCell id="resp" value="&lt;b&gt;ResponseUnit（响应发射单元）&lt;/b&gt;&#xa;组装并发送各类 CHI 响应 flit：&#xa;• Comp（写完成）&#xa;• CompData（读完成 + 数据）&#xa;• CompAck 回应&#xa;• RespSepData（先发 Comp 再发 Data）&#xa;• ReadReceipt&#xa;通过 RN 端的 RX.RSP / RX.DAT 发出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="800" y="530" width="200" height="150" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: RefillBuffer ===================== -->
    <mxCell id="refill" value="&lt;b&gt;RefillBuffer（回填缓冲）&lt;/b&gt;&#xa;接收来自 SN（内存）的 CompData&#xa;临时缓存后写入 DataStorage&#xa;同时转发给请求者 RN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1030" y="530" width="185" height="100" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: TX/RX Arbiters ===================== -->
    <mxCell id="tx_arb" value="&lt;b&gt;TX Channel Arbiter&lt;/b&gt;&#xa;合并多路 REQ/RSP/DAT&#xa;发往 SN（内存侧）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1240" y="530" width="150" height="80" as="geometry" />
    </mxCell>
    <mxCell id="rx_handler" value="&lt;b&gt;RX Handler&lt;/b&gt;&#xa;接收 SN 返回的&#xa;RSP / DAT flit&#xa;分发给 MSHR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1240" y="640" width="150" height="80" as="geometry" />
    </mxCell>

    <!-- ===================== Internal: PerfCounters ===================== -->
    <mxCell id="perf" value="&lt;b&gt;PerfCounters（性能计数器）&lt;/b&gt;&#xa;l3Miss 信号输出&#xa;TopDown 调试信号（robHeadPaddr + addrMatch）&#xa;enablePerf / elaboratedTopDown 配置控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="790" y="720" width="350" height="70" as="geometry" />
    </mxCell>

    <!-- ===================== Arrows: RN ports → RequestBuffer ===================== -->
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;" edge="1" source="rn0" target="rb" parent="1">
