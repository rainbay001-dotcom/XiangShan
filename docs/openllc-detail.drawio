    <mxCell id="e6" value="S1读/S3写" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C3D7A;endArrow=block;startArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s2" target="dir" parent="1">
