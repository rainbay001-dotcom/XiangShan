          <mxPoint x="1310" y="190" />
          <mxPoint x="1310" y="330" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- RxHandler → RefillBuffer (CompData): exit bottom, enter top-right, short vertical+horizontal path -->
    <mxCell id="e15" value="CompData" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#375623;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" source="rx_hdlr" target="refill" parent="1">
      <mxGeometry relative="1" as="geometry">
