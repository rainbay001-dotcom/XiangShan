          <mxPoint x="850" y="556" />
          <mxPoint x="850" y="680" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- RxHandler → MSHR (写完成Comp) -->
    <mxCell id="e15b" value="写完成Comp" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B5600;dashed=1;endArrow=open;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" edge="1" source="rx_hdlr" target="mshr" parent="1">
      <mxGeometry relative="1" as="geometry">
