    <!-- Row 3: 预取 -->
    <mxCell id="r3c0" value="L3 硬件预取" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="921" width="150" height="28" as="geometry"/></mxCell>
    <mxCell id="r3c1" value="✅ BOP + TP + L3PrefetchReceiver" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="921" width="210" height="28" as="geometry"/></mxCell>
