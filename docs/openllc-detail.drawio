    <mxCell id="e10" value="Miss完成响应" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8B2C28;endArrow=block;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="mshr" target="resp" parent="1">
      <mxGeometry relative="1" as="geometry" />
