    <mxCell id="e16" value="retry" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B5600;dashed=1;endArrow=open;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" source="mshr" target="ra" parent="1">
