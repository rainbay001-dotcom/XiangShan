    <mxCell id="ch1" value="HuanCun（TileLink）" style="text;html=1;strokeColor=#555555;align=center;fontStyle=1;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="170" y="1000" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="ch2" value="OpenLLC（CHI）" style="text;html=1;strokeColor=#555555;align=center;fontStyle=1;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="1000" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="ch3" value="说明 / 影响" style="text;html=1;strokeColor=#555555;align=center;fontStyle=1;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="590" y="1000" width="250" height="30" as="geometry"/></mxCell>

    <mxCell id="r1c0" value="互联协议" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="150" height="30" as="geometry"/></mxCell>
    <mxCell id="r1c1" value="TileLink（TL-C）" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="1030" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r1c2" value="CHI（E.b / AMBA5）" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="1030" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r1c3" value="面向 Arm CHI 生态，工业可移植性更强" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="1030" width="250" height="30" as="geometry"/></mxCell>

    <mxCell id="r2c0" value="双 Socket" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1060" width="150" height="30" as="geometry"/></mxCell>
    <mxCell id="r2c1" value="❌ 不支持" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="170" y="1060" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r2c2" value="✅ numRNs = N+1（XSBridge inject）" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="1060" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r2c3" value="额外 rn 槽接 XSBridge，实现双 Socket 一致性" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="1060" width="250" height="30" as="geometry"/></mxCell>

    <mxCell id="r3c0" value="L3 预取" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="150" height="30" as="geometry"/></mxCell>
    <mxCell id="r3c1" value="✅ BOP + TP + L3PrefetchReceiver" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="170" y="1090" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r3c2" value="❌ 当前无（OpenLLCParam 无 prefetch）" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="1090" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r3c3" value="HuanCun 预取更成熟；OpenLLC 预取待支持" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="1090" width="250" height="30" as="geometry"/></mxCell>

    <mxCell id="r4c0" value="数据校验" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1120" width="150" height="30" as="geometry"/></mxCell>
    <mxCell id="r4c1" value="✅ SECDED（tagECC + dataECC）" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="170" y="1120" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r4c2" value="CHI OddParity（chiDataCheck 配置）" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="1120" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r4c3" value="OpenNCB 在 AXI4 侧具备奇偶校验" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="1120" width="250" height="30" as="geometry"/></mxCell>

    <mxCell id="r5c0" value="流水线深度" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="150" height="30" as="geometry"/></mxCell>
    <mxCell id="r5c1" value="3 级（S1/S2/S3）" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="1150" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r5c2" value="4 级（S1/S2/S3/S4-提交）" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="1150" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r5c3" value="S4 分离响应分发，降低关键路径压力" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="1150" width="250" height="30" as="geometry"/></mxCell>

    <mxCell id="r6c0" value="缓存包含性" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1180" width="150" height="30" as="geometry"/></mxCell>
    <mxCell id="r6c1" value="可配置（生产: 非包含）" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="170" y="1180" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r6c2" value="CHI 天然支持非包含，Sharer 位图追踪" style="text;html=1;strokeColor=#555555;fontSize=10;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="1180" width="210" height="30" as="geometry"/></mxCell>
    <mxCell id="r6c3" value="默认行为等价非包含（无强制 victim 无效）" style="text;html=1;fillColor=none;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="1180" width="250" height="30" as="geometry"/></mxCell>

    <!-- ===================== OpenLLCParam Box (Right, y=970) ===================== -->
    <mxCell id="param_title" value="OpenLLCParam 核心参数" style="text;html=1;strokeColor=#555555;align=center;fontStyle=1;fontSize=11;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="870" y="970" width="390" height="30" as="geometry" />
    </mxCell>
    <mxCell id="params" value="case class OpenLLCParam(&#xa;  name           : String  = &quot;LLC&quot;,&#xa;  ways           : Int     = 8,       // 缓存路数&#xa;  sets           : Int     = 2048,    // 每 bank 组数&#xa;  banks          : Int     = 4,       // Bank 数 → 总 4MB&#xa;  fullAddressBits: Int     = 48,      // sv48 物理地址宽度&#xa;  clientCaches   : Seq[L2Param],      // 各 L2 参数&#xa;  hartIds        : Seq[Int] = Nil,    // 由 tiles 填入&#xa;  FPGAPlatform   : Boolean  = false,&#xa;  enablePerf     : Boolean  = false,  // 性能计数器开关&#xa;)" style="text;html=1;align=left;verticalAlign=top;strokeColor=#555555;fontFamily=Courier New;fontSize=10;whiteSpace=pre;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="870" y="1000" width="390" height="200" as="geometry" />
    </mxCell>

    <!-- ===================== CHI PortIO Detail Box (Far Right, y=970) ===================== -->
    <mxCell id="portio_title" value="PortIO（CHI E.b）信号明细" style="text;html=1;strokeColor=#555555;align=center;fontStyle=1;fontSize=11;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="1280" y="970" width="380" height="30" as="geometry" />
    </mxCell>
    <mxCell id="portio" value="TX（HN 发给 RN 或 SN）:&#xa;  REQ: flitpend/flitv/flit(256b)/lcrdv&#xa;  RSP: flitpend/flitv/flit(128b)/lcrdv&#xa;  DAT: flitpend/flitv/flit(512b)/lcrdv&#xa;  linkactiveack : Bool&#xa;&#xa;RX（HN 从 RN 或 SN 接收）:&#xa;  SNP: flitpend/flitv/flit(256b)/lcrdv&#xa;  RSP: flitpend/flitv/flit(128b)/lcrdv&#xa;  DAT: flitpend/flitv/flit(512b)/lcrdv&#xa;  linkactivereq : Bool&#xa;&#xa;链路控制:&#xa;  rxsactive : Bool&#xa;  syscoreq  : Bool&#xa;  syscoack  : Bool" style="text;html=1;align=left;verticalAlign=top;strokeColor=#555555;fontFamily=Courier New;fontSize=10;whiteSpace=pre;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="1280" y="1000" width="380" height="260" as="geometry" />
    </mxCell>

    <!-- ===================== Description Table ===================== -->
    <mxCell id="desc_table_title" value="说明表 / Description Table" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="1340" width="400" height="40" as="geometry" />
    </mxCell>
    <mxCell id="desc_table_content" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;th&gt;模块 / Module&lt;/th&gt;&lt;th&gt;说明 / Description&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;io.rn[0]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Core 0 / CHIHNSubNode&lt;br/&gt;TX: REQ(256b)/RSP(128b)/DAT(512b)&lt;br/&gt;RX: SNP(256b)/RSP(128b)/DAT(512b)&lt;br/&gt;linkactive* / rxsactive&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;io.rn[1]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Core 1 / CHIHNSubNode&lt;br/&gt;TX: REQ(256b)/RSP(128b)/DAT(512b)&lt;br/&gt;RX: SNP(256b)/RSP(128b)/DAT(512b)&lt;br/&gt;linkactive* / rxsactive&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;io.rn[N]&lt;/b&gt;（可选）&lt;/td&gt;&lt;td&gt;双 Socket XSBridge&lt;br/&gt;numRNs = NumCores + 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RequestBuffer&lt;/b&gt;&lt;/td&gt;&lt;td&gt;接收各 RN REQ/SNP flit&lt;br/&gt;按 srcID 排队，流控&lt;br/&gt;lcrdv 信用计数回流&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RequestArbiter&lt;/b&gt;&lt;/td&gt;&lt;td&gt;多路优先级仲裁：&lt;br/&gt;① 新请求（来自 RB）&lt;br/&gt;② MSHR retry 请求&lt;br/&gt;③ Snoop 二次请求&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;S1：地址解码 &amp;amp; 索引&lt;/b&gt;&lt;/td&gt;&lt;td&gt;• 物理地址拆分：&lt;br/&gt;  Bank[1:0] / Set[10:0] / Tag&lt;br/&gt;• 发起 Directory SRAM 读&lt;br/&gt;• 发起 DataStorage SRAM 读&lt;br/&gt;• 生成 Way 选择候选&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;S2：命中判定 &amp;amp; 一致性决策&lt;/b&gt;&lt;/td&gt;&lt;td&gt;• tag 比对 → hit / miss&lt;br/&gt;• 读取 State: I/SC/UC/UD/SD&lt;br/&gt;• 确定操作类型：&lt;br/&gt;  ReadShared / WriteBack / MakeUnique&lt;br/&gt;• Miss：分配 MSHR 槽位&lt;br/&gt;• Hit：准备 S3 直接响应&lt;br/&gt;• 判断是否需要 Snoop&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;S3：数据 &amp;amp; 目录写回&lt;/b&gt;&lt;/td&gt;&lt;td&gt;• 命中读：从 DataSRAM 取数&lt;br/&gt;  → 生成 CompData 发 RN&lt;br/&gt;• 命中写：更新 DataSRAM&lt;br/&gt;  + 更新 Directory State&lt;br/&gt;• 缺失：写入 MSHR，等待：&lt;br/&gt;  (a) Snoop 响应聚合&lt;br/&gt;  (b) SN CompData 回填&lt;br/&gt;• WB/Evict：无效化 + 释放&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;S4：提交 &amp;amp; 响应分发&lt;/b&gt;&lt;/td&gt;&lt;td&gt;• 向 ResponseUnit 发送：&lt;br/&gt;  Comp / CompData /&lt;br/&gt;  CompAck / DBIDResp&lt;br/&gt;• 向 SnoopUnit 触发 Snoop&lt;br/&gt;• 更新 MSHR 状态机&lt;br/&gt;• 流水线反压（hazard）&lt;br/&gt;  相同 Set 需等待前序完成&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;TX Arbiter（发送仲裁）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;向 io.sn（OpenNCB）输出：&lt;br/&gt;• REQ：ReadNoSnp / WriteNoSnpFull&lt;br/&gt;• DAT：NonCopyBackWrData&lt;br/&gt;向各 RN 输出：&lt;br/&gt;• RSP：Comp / DBIDResp / RetryAck&lt;br/&gt;• DAT：CompData / RespSepData&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RX Handler（下行接收）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;从 io.sn 接收来自 OpenNCB 的响应：&lt;br/&gt;• RX.RSP：Comp / DBIDResp&lt;br/&gt;  → 通知 MSHR 内存写完成&lt;br/&gt;• RX.DAT：CompData（内存读数据）&lt;br/&gt;  → 送往 RefillBuffer 处理&lt;br/&gt;lcrdv 信用回流控制发送速率&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;io.sn&lt;/b&gt;&lt;/td&gt;&lt;td&gt;（→ OpenNCB LLC Bridge）&lt;br/&gt;TX: REQ(256b) / DAT(512b)&lt;br/&gt;RX: RSP(128b) / DAT(512b)&lt;br/&gt;（OpenLLC 作为 Requester&lt;br/&gt;向 SN 发起内存读写）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;MSHR Array（未命中状态保持寄存器）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;每项跟踪一个 in-flight 缺失事务：&lt;br/&gt;• addr / opcode / srcID / txnID&lt;br/&gt;• state : 等待 Snoop / 等待内存 / 等待 CompAck…&lt;br/&gt;• gotPendingSnp : Vec(numRNs.W) — Snoop 收齐位图&lt;br/&gt;• gotDirtyData : Bool — 脏数据已收到&lt;br/&gt;• dataBuffer : UInt(512.W) — 数据暂存&lt;br/&gt;MSHR 满 → 向 RN 返回 RetryAck（反压）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Directory（目录 SRAM）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;每 Cacheline 条目：&lt;br/&gt;• valid : Bool&lt;br/&gt;• tag   : UInt(tagBits.W)&lt;br/&gt;• state : CHI State（5 bits）&lt;br/&gt;  I / SC / UC / UD / SD&lt;br/&gt;• clients : UInt(numRNs.W) — Sharer 位图&lt;br/&gt;容量：8ways × 2048sets × 4banks = 524,288 项&lt;br/&gt;S1 读 → S3/S4 写（单口 SRAM）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;DataStorage（数据 SRAM）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;• 每行 512-bit（64B per cacheline）&lt;br/&gt;• 总容量：8w × 2048s × 4b × 64B = 4MB&lt;br/&gt;• 分 bank 并行，减少访问冲突&lt;br/&gt;• 支持 OddParity 数据校验&lt;br/&gt;  （chiDataCheck 参数控制）&lt;br/&gt;• S1 发读请求，S3 读结果 / 写数据&lt;br/&gt;• RefillBuffer 回填后写入&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RefillBuffer（回填缓冲）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;接收 SN (OpenNCB→DRAM) 返回的&lt;br/&gt;CompData flit：&lt;br/&gt;• 将 data 写入 DataStorage&lt;br/&gt;• 更新对应 MSHR 的 dataBuffer&lt;br/&gt;• 触发 MSHR 后续处理流程&lt;br/&gt;  （组装 CompData 发 RN&lt;br/&gt;   或先 Snoop 再转发）&lt;br/&gt;• 支持多拍 Beat 拼接（512b）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;SnoopUnit（Snoop 发射单元）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;根据 MSHR + Directory Sharer 位图&lt;br/&gt;生成 Snoop 命令发往 RN.RX.SNP：&lt;br/&gt;• SnpShared      — 降权共享&lt;br/&gt;• SnpUnique      — 独占/无效化&lt;br/&gt;• SnpCleanInvalid — 强制无效化&lt;br/&gt;• SnpMakeInvalid — 快速无效化&lt;br/&gt;收集所有 SnpResp / SnpRespData：&lt;br/&gt;• 更新 MSHR.gotPendingSnp 位图&lt;br/&gt;• 携带脏数据 → 写入 DataStorage&lt;br/&gt;全部 Snoop 响应到齐 → 解锁 MSHR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ResponseUnit（响应组装单元）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;从 MainPipe S3（命中读）/ S4（提交）/ MSHR 接收指令，&lt;br/&gt;组装 CHI 响应 flit 并发往 RN：&lt;br/&gt;• Comp         — 写入/权限转换完成&lt;br/&gt;• CompData     — 读命中时附数据&lt;br/&gt;• CompAck      — 等待 RN Ack 确认&lt;br/&gt;• RespSepData  — 先响应后发数据&lt;br/&gt;• DBIDResp     — 写数据缓冲分配&lt;br/&gt;• RetryAck     — 反压（MSHR 满）&lt;br/&gt;也向 SN 发 ReadNoSnp / WriteNoSnpFull&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="20" y="1390" width="1660" height="1080" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
