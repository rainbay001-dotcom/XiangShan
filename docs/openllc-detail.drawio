    <!-- RefillBuffer → ResponseUnit (CompData数据就绪，触发响应组装): ③→④ 关键路径 -->
    <mxCell id="e_rb_resp" value="触发CompData响应" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#8B2C28;endArrow=block;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" source="refill" target="resp" parent="1">
