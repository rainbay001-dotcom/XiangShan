          <mxPoint x="600" y="700" />
          <mxPoint x="1050" y="700" />
          <mxPoint x="1050" y="142" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- TxArb → SN (REQ/DAT→SN) -->
    <mxCell id="e13" value="REQ/DAT→SN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#375623;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="tx_arb" target="sn" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- SN → RxHandler (RSP/DAT←SN) -->
    <mxCell id="e14" value="RSP/DAT←SN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#375623;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="sn" target="rx_hdlr" parent="1">
      <mxGeometry relative="1" as="geometry">
