    <!-- Row 1: 协议 -->
    <mxCell id="r1c0" value="互联协议" style="text;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="865" width="150" height="28" as="geometry"/></mxCell>
