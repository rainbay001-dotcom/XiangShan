        <!-- PortIO structure detail box -->
        <mxCell id="portio_detail" value="PortIO 信号构成（CHI E.b 11-bit NodeID）&#xa;────────────────────────────────────────&#xa;flit 宽度：REQ=256b  RSP=128b  DAT=512b  SNP=256b&#xa;tx.req.{flitpend, flitv, flit[255:0], lcrdv}&#xa;tx.rsp.{flitpend, flitv, flit[127:0], lcrdv}&#xa;tx.dat.{flitpend, flitv, flit[511:0], lcrdv}&#xa;tx.linkactiveack&#xa;rx.snp.{flitpend, flitv, flit[255:0], lcrdv}&#xa;rx.rsp.{flitpend, flitv, flit[127:0], lcrdv}&#xa;rx.dat.{flitpend, flitv, flit[511:0], lcrdv}&#xa;rx.linkactivereq&#xa;rxsactive（RX 通路激活）&#xa;syscoreq / syscoack（系统一致性握手）&#xa;────────────────────────────────────────&#xa;Flipped(PortIO)：tx/rx 方向对调，&#xa;即 Bridge 为接收方，Socket 为发送方" style="rounded=0;whiteSpace=pre;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
