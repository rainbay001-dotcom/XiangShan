        <!-- CHI 协议节点角色说明框                                        -->
        <!-- ============================================================ -->

        <mxCell id="90" value="&lt;b&gt;CHI 协议节点角色说明&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;RN (Request Node)&lt;/b&gt;：发起 CHI 事务的节点，如 CoreWithL2 (L2 侧) 和 CHIHNSubNode (OpenLLC 侧)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;HN (Home Node)&lt;/b&gt;：负责缓存一致性仲裁，接收 RN 请求并协调 Snoop，如 OpenLLC 和 CHIHNSubNode (L2 侧)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;SN (Slave Node)&lt;/b&gt;：响应 HN 下发的内存访问，通常对接 DRAM 控制器（OpenNCB LLC Bridge 扮演此角色）&lt;br/&gt;&lt;br/&gt;&lt;b&gt;CHIHNSubNode 双重角色&lt;/b&gt;：&lt;br/&gt;· 面向 CoreWithL2 (L2 侧) ＝ HN-F，接受 RN 请求&lt;br/&gt;· 面向 OpenLLC ＝ RN，向 OpenLLC (HN-F) 发起请求" style="text;html=1;align=left;verticalAlign=top;strokeColor=#555555;fillColor=#ffffff;fontSize=11;rounded=1;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="20" y="1040" width="740" height="185" as="geometry"/>
        </mxCell>


        <!-- ============================================================ -->
        <!-- 关键差异标注框                                                -->
        <!-- ============================================================ -->

        <mxCell id="91" value="&lt;b&gt;架构关键差异（原始 vs 当前）&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;① CHILogger 名称变化：&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;L2[i]_LLC&quot; → &quot;L2[i]_HN&quot;（面向HN）&lt;br/&gt;&lt;br/&gt;② 新增 CHIHNSubNode：&lt;br/&gt;&amp;nbsp;&amp;nbsp;双角色桥接层（HN-F ↔ RN）&lt;br/&gt;&lt;br/&gt;③ 新增 CHILogger &quot;HN[i]_LLC&quot;：&lt;br/&gt;&amp;nbsp;&amp;nbsp;HNSubNode 到 OpenLLC 的调试日志&lt;br/&gt;&lt;br/&gt;④ CHI 路径增加 1 跳：&lt;br/&gt;&amp;nbsp;&amp;nbsp;L2 → HNSubNode → OpenLLC&lt;br/&gt;&lt;br/&gt;⑤ 未来扩展点：集群目录 / Snoop 过滤 / 请求合并" style="text;html=1;align=left;verticalAlign=top;strokeColor=#9673a6;fillColor=#f5eeff;fontSize=11;rounded=1;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="780" y="1040" width="500" height="185" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
